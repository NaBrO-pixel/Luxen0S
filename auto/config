#!/bin/sh
#
# Live Build Configuration Script for LuxenOS
# A Debian-based desktop OS with native Android app support (Waydroid).
#
# The result is a standard live-build "iso-hybrid" image that boots from
# USB/DVD on BIOS and UEFI. VARIANT picks what it boots:
#   installer    (default) a live system (squashfs + live-boot/live-config)
#                that starts straight into the Calamares installer
#   live         the same live system, starting the full Sway desktop
#   traditional  NOT live: boots the Debian installer (d-i) directly, which
#                copies the LuxenOS root filesystem to disk. No live session
#                runs from the USB stick at any point.
# All three carry the same root filesystem; both installers copy it to disk.
# See README.md ("How LuxenOS boots").
#
# Option names follow live-build 5 (Debian 13 "trixie"): --binary-image,
# --bootloaders, --bootappend-live. Hostname, live user, locale and timezone
# are live-config boot parameters, not lb config options.

set -e

# ============================================================================
# Configuration Variables
# ============================================================================

DISTRIBUTION="${DISTRIBUTION:-trixie}"
# Supported releases. Debian 13 "trixie" is the stable base LuxenOS is built
# and released on. Debian 14 "forky" is Debian's *testing* release (no
# release date announced as of LuxenOS 2026.11): its packages change daily and
# some LuxenOS components are not in it at all (Wine, wlgreet; see README.md,
# "Debian 14"). Building on it is possible for development only and must be
# asked for explicitly, so a typo can never produce a "trixie" ISO that is not.
case $DISTRIBUTION in
    trixie) ;;
    forky)
        if [ "${LUXENOS_EXPERIMENTAL_FORKY:-0}" != 1 ]; then
            echo "ERROR: DISTRIBUTION=forky (Debian 14, testing) is experimental; set LUXENOS_EXPERIMENTAL_FORKY=1 to build it anyway" >&2
            exit 1
        fi
        echo "WARNING: building on Debian 14 'forky' (testing): not a supported LuxenOS release" >&2
        ;;
    *)
        echo "ERROR: DISTRIBUTION must be 'trixie' (Debian 13) or 'forky' (Debian 14, experimental); got '$DISTRIBUTION'" >&2
        exit 1
        ;;
esac
ARCHITECTURES="${ARCHITECTURES:-amd64}"
ARCHIVE_AREAS="${ARCHIVE_AREAS:-main contrib non-free non-free-firmware}"
BOOTAPPEND="${BOOTAPPEND:-quiet splash}"
BOOTLOADERS="${BOOTLOADERS:-syslinux,grub-efi}"
HOSTNAME="${HOSTNAME:-luxenos}"

# Live session account, created by live-config at boot and deleted again by
# the Calamares "removeuser" job. Its one definition is removeuser.conf: the
# installer-kiosk hook (tty1 autologin) reads the same file, so the three can
# never disagree. Deliberately NOT taken from $USERNAME: desktop sessions
# export that as the builder's own login name, which made the live user e.g.
# "alice" while Calamares and the autologin expected "user".
REMOVEUSER_CONF=config/includes.chroot/etc/calamares/modules/removeuser.conf
LIVE_USERNAME=$(sed -n '/^username:/{s/^username:[[:space:]]*//;s/[[:space:]]*#.*//;s/[[:space:]]*$//;p;}' "$REMOVEUSER_CONF" 2>/dev/null | head -n1)
case $LIVE_USERNAME in
    ''|*[!a-z0-9_-]*)
        echo "ERROR: no valid 'username:' in $REMOVEUSER_CONF (got '$LIVE_USERNAME')" >&2
        exit 1
        ;;
esac

LOCALE="${LOCALE:-en_US.UTF-8}"
TIMEZONE="${TIMEZONE:-UTC}"

MIRROR_BOOTSTRAP="${MIRROR_BOOTSTRAP:-http://deb.debian.org/debian}"
MIRROR_CHROOT="${MIRROR_CHROOT:-http://deb.debian.org/debian}"
MIRROR_CHROOT_SECURITY="${MIRROR_CHROOT_SECURITY:-http://security.debian.org/debian-security}"

# Build variant: what the image boots into.
#   installer    live system, straight into the Calamares installer (default)
#   live         live system, straight into the full Sway desktop; the
#                installer is still installed and can be started from the
#                launcher
#   traditional  no live system: the boot menu starts the Debian installer
#                (graphical, text and expert modes). Its live-installer step
#                copies the same LuxenOS squashfs to disk, and
#                config/includes.installer/preseed.cfg runs the same
#                post-install cleanup Calamares does. The live boot entries
#                are removed by config/hooks/live/0900-traditional-boot-menu.hook.binary.
# The root filesystem is the same in all three; only what boots differs.
VARIANT="${VARIANT:-installer}"

# --debian-installer: "none" leaves d-i off the ISO; "live" adds d-i set up to
# install the live squashfs (live-installer) instead of fetching packages.
DEBIAN_INSTALLER=none

case $VARIANT in
    installer)
        LUXENOS_SESSION=""
        ;;
    live)
        # Read by /etc/profile.d/luxenos-session.sh, which starts the installer
        # kiosk unless this parameter is on the kernel command line.
        LUXENOS_SESSION="luxenos.session=desktop"
        ;;
    traditional)
        LUXENOS_SESSION=""
        DEBIAN_INSTALLER=live
        ;;
    *)
        echo "ERROR: VARIANT must be 'installer', 'live' or 'traditional' (got '$VARIANT')" >&2
        exit 1
        ;;
esac

# ISO boot: syslinux (BIOS) + grub-efi (UEFI). The GRUB theme shipped in
# config/includes.chroot/boot/grub/themes/luxenos/ applies to the installed
# system.
#
# Secure Boot (opt-in, LUXENOS_SECURE_BOOT=1, UNTESTED on real firmware): asks
# live-build for the Microsoft-signed shim + Debian-signed GRUB on the ISO
# (--uefi-secure-boot enable) and adds shim-signed / grub-efi-amd64-signed to
# the installed system, so grub-install sets up the same signed chain. Debian's
# kernels are signed already. Without it nothing is passed and live-build's
# default applies, exactly as before. See README.md, "Secure Boot".
SECURE_BOOT_ARGS=""
case ${LUXENOS_SECURE_BOOT:-0} in
    1)
        SECURE_BOOT_ARGS="--uefi-secure-boot enable"
        ;;
    0) ;;
    *)
        echo "ERROR: LUXENOS_SECURE_BOOT must be 0 or 1 (got '${LUXENOS_SECURE_BOOT}')" >&2
        exit 1
        ;;
esac
# Labels differ per variant so the two images are told apart on a USB stick.
case $VARIANT in
    live)
        ISO_APPLICATION="${ISO_APPLICATION:-LuxenOS Live}"
        ISO_VOLUME="${ISO_VOLUME:-LUXENOS-LIVE}"
        ;;
    traditional)
        ISO_APPLICATION="${ISO_APPLICATION:-LuxenOS Installer}"
        ISO_VOLUME="${ISO_VOLUME:-LUXENOS-INSTALL}"
        ;;
    *)
        ISO_APPLICATION="${ISO_APPLICATION:-LuxenOS}"
        ISO_VOLUME="${ISO_VOLUME:-LUXENOS}"
        ;;
esac

# ============================================================================
# Helper Functions
# ============================================================================

show_usage() {
    cat <<USAGE
Usage: $0 [options]

Configure the live-build environment for LuxenOS.

VARIANT selects what the ISO boots: a live system running the Calamares
installer (VARIANT=installer, the default), a live system running the full Sway
desktop (VARIANT=live), or no live system at all -- the Debian installer, booted
straight from the ISO like a traditional install disc (VARIANT=traditional).
On the two live images the default session can be overridden at boot by
editing the kernel command line: add luxenos.session=desktop for the desktop,
remove it for the installer. After installation the system boots to a greetd login prompt that starts Sway.

Environment variables:
  VARIANT                   Image variant: installer, live or traditional
                            (default: installer)
  DISTRIBUTION              Debian release: trixie (default, Debian 13) or
                            forky (Debian 14 testing; needs
                            LUXENOS_EXPERIMENTAL_FORKY=1)
  LUXENOS_SECURE_BOOT       1: signed shim/GRUB on the ISO and the installed
                            system (untested; default 0)
  ARCHITECTURES             Target architecture (default: amd64)
  BOOTLOADERS               ISO bootloaders (default: syslinux,grub-efi)
  BOOTAPPEND                Extra kernel parameters (default: quiet splash)
  ARCHIVE_AREAS             Repository areas (default: main contrib non-free non-free-firmware)
  HOSTNAME                  System hostname (default: luxenos)
  (The live user is not an environment variable: it is the 'username:' in
  config/includes.chroot/etc/calamares/modules/removeuser.conf, default: user.)
  LOCALE                    System locale (default: en_US.UTF-8)
  TIMEZONE                  System timezone (default: UTC)
  MIRROR_BOOTSTRAP          Bootstrap mirror URL
  MIRROR_CHROOT             Chroot mirror URL
  MIRROR_CHROOT_SECURITY    Security mirror URL

  Waydroid/Android setup (all optional, defaults in config/hooks/live/0100-install-waydroid.hook.chroot):
  WAYDROID_VERSION, WAYDROID_IMAGE_TYPE (GAPPS|VANILLA), WAYDROID_REPO_URL,
  WAYDROID_INSTALL_SCRIPT, AURORA_STORE_URL, AURORA_STORE_DIR,
  AURORA_STORE_SHA256, DOWNLOAD_RETRIES, CURL_TIMEOUT.
  Set LUXENOS_ALLOW_UNPINNED_DOWNLOADS=1 to build without AURORA_STORE_SHA256
  (dev builds only -- never for a release you'll distribute).

Options:
  -h, --help               Show this help message
  Any other options are passed to 'lb config'

Examples:
  $0                     Build the installer image (boots into Calamares)
  VARIANT=live $0        Build the live image (boots into the Sway desktop)
  VARIANT=traditional $0 Build the traditional image (boots the Debian
                         installer, no live session)
USAGE
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    show_usage
    exit 0
fi

BOOTAPPEND_LIVE="boot=live components $BOOTAPPEND hostname=$HOSTNAME username=$LIVE_USERNAME locales=$LOCALE timezone=$TIMEZONE"
if [ -n "$LUXENOS_SESSION" ]; then
    BOOTAPPEND_LIVE="$BOOTAPPEND_LIVE $LUXENOS_SESSION"
fi

# Image size: live-build installs every Recommends by default, which made the
# root filesystem ~5.5 GiB. --apt-recommends false brings it to ~3.8 GiB; the
# recommended packages LuxenOS really needs are listed explicitly in
# config/package-lists/essentials.list.chroot. --apt-indices false leaves the
# apt package lists (~100-200 MB with i386 enabled) out of the image; the
# installed system fetches them with "apt-get update" (unattended-upgrades,
# luxenos-updater, and luxenos-deb-install's "Refresh and retry").
# Signed boot chain for the installed system: written here (lb config is the
# step that generates config/), removed again when Secure Boot is off.
SB_LIST=config/package-lists/secureboot.list.chroot
if [ -n "$SECURE_BOOT_ARGS" ]; then
    cat > "$SB_LIST" <<'SBLIST'
# Generated by auto/config because LUXENOS_SECURE_BOOT=1. Do not edit.
shim-signed
grub-efi-amd64-signed
SBLIST
else
    rm -f "$SB_LIST"
fi

# shellcheck disable=SC2086  # SECURE_BOOT_ARGS is empty or two words
lb config noauto \
    --binary-image iso-hybrid \
    --apt-recommends false \
    --apt-indices false \
    --mode debian \
    --distribution "$DISTRIBUTION" \
    --architecture "$ARCHITECTURES" \
    --archive-areas "$ARCHIVE_AREAS" \
    --bootappend-live "$BOOTAPPEND_LIVE" \
    --bootloaders "$BOOTLOADERS" \
    --debian-installer "$DEBIAN_INSTALLER" \
    --mirror-bootstrap "$MIRROR_BOOTSTRAP" \
    --mirror-chroot "$MIRROR_CHROOT" \
    --mirror-chroot-security "$MIRROR_CHROOT_SECURITY" \
    --iso-application "$ISO_APPLICATION" \
    --iso-volume "$ISO_VOLUME" \
    $SECURE_BOOT_ARGS \
    "$@"
