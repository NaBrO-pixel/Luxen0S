# Sway/Wayland desktop stack. This is the desktop of the installed system
# (and of the live session when booted with luxenos.session=desktop). The
# default live session runs only the installer kiosk, see
# config/hooks/live/0150-installer-kiosk.hook.chroot.
#
# Mandatory for the graphical session: sway swaylock swayidle waybar wofi
# dunst foot polkit agent + pkexec/polkitd, zenity, fonts, adwaita-icon-theme,
# network-manager-gnome (base list: nm-applet, nm-connection-editor).
# Optional/nice-to-have: nwg-look, swappy, grim/slurp, thunar/tumbler.
# SwayFX (blur, rounded corners, shadows) is optional and NOT in Debian; the
# glass theme detects it at runtime and falls back to stock Sway.
sway
swaylock
swayidle
waybar
xwayland
xdg-desktop-portal
xdg-desktop-portal-wlr
xdg-desktop-portal-gtk
libwayland-dev
libinput-dev
foot
wofi
grim
slurp
swappy
wl-clipboard
brightnessctl
dunst
nwg-look
polkit-kde-agent-1

# Audio
pipewire
pipewire-pulse
wireplumber
pavucontrol-qt
alsa-utils
alsa-firmware

# File manager
thunar
tumbler

# Fonts
fonts-noto
fonts-font-awesome
fonts-dejavu

# Everyday apps
firefox-esr
mpv
evince
gedit

# Liquid-glass theme, .deb / .exe double-click integration
zenity
pkexec
polkitd
libnotify-bin
desktop-file-utils
shared-mime-info
xdg-utils
adwaita-icon-theme
fonts-inter
file
libglib2.0-bin
dconf-gsettings-backend
dconf-service

# xdg-desktop-portal-gtk is what delivers the dark/light colour scheme to GTK4/
# libadwaita apps (verified: without a portal Settings backend they stay light).
#
# Session plumbing used by luxenos-session-init / luxenos-glass
dbus-user-session
dbus-bin
procps
