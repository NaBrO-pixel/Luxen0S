# Sway/Wayland desktop stack. This is the desktop of the installed system
# (and of the live session when booted with luxenos.session=desktop). The
# default live session runs only the installer kiosk, see
# config/hooks/live/0150-installer-kiosk.hook.chroot.
#
# Mandatory for the graphical session: sway swaylock swayidle waybar wofi
# dunst foot polkit agent + pkexec/polkitd, zenity, fonts, adwaita-icon-theme,
# network-manager-gnome (base list: nm-applet, nm-connection-editor).
# Optional/nice-to-have: nwg-look, swappy, grim/slurp, thunar/tumbler.
# SwayFX is built from pinned upstream sources by
# config/hooks/live/0200-build-swayfx.hook.chroot; stock Sway remains installed
# as a package fallback, while /usr/local/bin takes priority in the user PATH.
sway
swaylock
swayidle
# Draws every `output * bg` wallpaper (desktop, greeter, installer kiosk).
# Only a Recommends of sway, and the image is built without Recommends.
swaybg
waybar
xwayland
xdg-desktop-portal
xdg-desktop-portal-wlr
xdg-desktop-portal-gtk
foot
wofi
grim
slurp
swappy
wl-clipboard
brightnessctl
dunst
nwg-look
# Flathub is added by hook 0200; luxenos-updater and luxenos-health-check use
# both of these.
flatpak
fwupd
polkit-kde-agent-1
# Qt apps (polkit-kde password prompt, pavucontrol-qt) get the glass palette
# through qt6ct (QT_QPA_PLATFORMTHEME=qt6ct, config from luxenos-glass).
qt6ct

# Audio
pipewire
pipewire-pulse
wireplumber
pavucontrol-qt
alsa-utils
# No alsa-firmware here: Debian has no such package (its nearest equivalent,
# alsa-firmware-loaders, is for legacy cards that upload firmware at probe
# time). Audio firmware comes from firmware-linux and firmware-misc-nonfree
# in base.list.chroot.

# File manager
thunar
tumbler

# Fonts
fonts-noto
fonts-font-awesome
fonts-dejavu

# Everyday apps
firefox-esr
mpv
evince
gedit

# Liquid-glass theme, .deb / .exe double-click integration
zenity
pkexec
polkitd
libnotify-bin
desktop-file-utils
shared-mime-info
xdg-utils
adwaita-icon-theme
fonts-inter
file
libglib2.0-bin
dconf-gsettings-backend
dconf-service

# xdg-desktop-portal-gtk is what delivers the dark/light colour scheme to GTK4/
# libadwaita apps (verified: without a portal Settings backend they stay light).
#
# Session plumbing used by luxenos-session-init / luxenos-glass
dbus-user-session
dbus-bin
procps
