{
    "include": ["~/.config/luxenos/glass/waybar.json"],
    "modules-left": ["sway/workspaces", "sway/mode"],
    "modules-center": ["clock"],
    "modules-right": ["custom/power-profile", "pulseaudio", "network", "battery", "tray", "custom/quick-settings", "custom/controls"],

    "sway/workspaces": {
        "disable-scroll": true,
        "format": "{name}"
    },
    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "{:%A, %d %B %Y}"
    },
    "battery": {
        "format": "{icon} {capacity}%",
        "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"],
        "format-charging": "\uf0e7 {capacity}%"
    },
    "custom/power-profile": {
        "exec": "luxenos-power-profile-status",
        "return-type": "json",
        "on-click": "luxenos-power-profile-cycle",
        "interval": 15,
        "signal": 8,
        "tooltip": true
    },
    "network": {
        "format-wifi": "\uf1eb {essid}",
        "format-ethernet": "\uf0e8 Connected",
        "format-disconnected": "⚠ Offline",
        "tooltip-format": "{ifname}: {ipaddr}",
        "on-click": "luxenos-network"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "\uf026 Muted",
        "format-icons": ["\uf026", "\uf027", "\uf028"],
        "on-click": "pavucontrol-qt"
    },
    "tray": {
        "spacing": 10
    },
    "custom/quick-settings": {
        "format": "\uf1de",
        "tooltip-format": "Quick Settings (Super+N)",
        "on-click": "luxenos-quick-settings"
    },
    "custom/controls": {
        "format": "\uf013",
        "tooltip": false,
        "on-click": "luxenos-controls"
    }
}
