# LuxenOS Installer Edition - kiosk session.
# Used only by the live USB session: /etc/profile.d/luxenos-session.sh starts
# `sway -c` with this file when the kernel command line has boot=live.
# It is removed from the installed system by the Calamares shellprocess job
# (etc/calamares/modules/shellprocess-luxenos-cleanup.conf), and an installed
# system never has boot=live anyway, so it boots the normal desktop from
# etc/skel/.config/sway/config.
#
# To try the full desktop from the live USB instead, add
# luxenos.session=desktop to the kernel command line.

set $mod Mod4
font pango:Noto Sans 10

output * bg /usr/share/backgrounds/luxenos/wallpaper.png fill

# No bar, no launcher, no window management chrome — just the installer.
exec calamares
for_window [app_id="calamares"] fullscreen enable
bindsym $mod+Shift+e exec swaymsg exit

# If someone closes Calamares without finishing, offer a terminal instead of
# a dead compositor, and let them retry.
exec_always sh -c 'wl-paste >/dev/null 2>&1 || true'
bindsym $mod+Return exec foot
bindsym $mod+Shift+r exec calamares
