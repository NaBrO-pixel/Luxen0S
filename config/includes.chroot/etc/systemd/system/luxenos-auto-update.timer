[Unit]
Description=LuxenOS Daily Automatic Updates Timer
# No Requires=luxenos-auto-update.service: that would start the update
# whenever the timer starts (every boot), not only on schedule. A timer
# triggers the service of the same name by itself.

[Timer]
# Run daily at 2 AM (system time)
OnCalendar=*-*-* 02:00:00

# Run on boot if missed (e.g., system was off at 2 AM)
Persistent=true

# Randomize by up to 1 hour to avoid network storms
RandomizedDelaySec=1h

[Install]
WantedBy=timers.target
