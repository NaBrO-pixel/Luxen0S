[Unit]
Description=LuxenOS Daily Automatic Updates Timer
Requires=luxenos-auto-update.service

[Timer]
# Run daily at 2 AM (system time)
OnCalendar=daily
OnCalendar=*-*-* 02:00:00

# Run on boot if missed (e.g., system was off at 2 AM)
Persistent=true

# Randomize by up to 1 hour to avoid network storms
RandomizedDelaySec=1h

[Install]
WantedBy=timers.target
