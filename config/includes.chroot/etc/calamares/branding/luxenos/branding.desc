---
# Calamares branding component for LuxenOS.
# Referenced from /etc/calamares/settings.conf via `branding: luxenos`.

componentName: luxenos

welcomeStyleCalamares: false
welcomeExpandingLogo: true

strings:
    productName:         "LuxenOS Installer Edition"
    shortProductName:    "LuxenOS"
    version:             "1.2.0"
    shortVersion:        "1.2.0"
    versionedName:       "LuxenOS 1.2.0"
    shortVersionedName:  "LuxenOS 1.2.0"
    bootloaderEntryName: "LuxenOS"
    productUrl:          "https://github.com/NaBrO-pixel/Luxen0S"
    supportUrl:          "https://github.com/NaBrO-pixel/Luxen0S/issues"
    knownIssuesUrl:      "https://github.com/NaBrO-pixel/Luxen0S/blob/main/issues.md"
    releaseNotesUrl:     "https://github.com/NaBrO-pixel/Luxen0S/releases"

images:
    productLogo:         "logo.png"
    productIcon:         "logo.png"
    productWelcome:      "welcome.png"

slideshow: "show.qml"

style:
   sidebarBackground:    "#1d2330"
   sidebarText:           "#e0e6f0"
   sidebarTextSelect:     "#ffffff"
   sidebarTextHighlight:  "#5e81ac"
