# Minimal compositor config for the graphical greetd login screen.
# luxenos-greeter exits this compositor after successful authentication so
# greetd can start the selected user session.

# Same liquid-glass look as the desktop and the lock screen: wlgreet paints a
# translucent glass tint (colours generated from /etc/luxenos/glass.conf) over
# the frosted, pre-blurred LuxenOS wallpaper. No compositor blur is needed, so
# it looks the same on stock Sway and SwayFX.
output * bg /usr/share/backgrounds/luxenos/wallpaper-blur.png fill

exec /usr/libexec/luxenos/luxenos-greeter

include /etc/sway/config.d/*
