#!/bin/sh
# luxenos-pkg-root - the ONLY privileged part of LuxenOS's graphical package
# tools. It is started through pkexec (polkit action org.luxenos.pkg.install,
# admin authentication required every time) by luxenos-deb-install,
# luxenos-wine-open and the Software Center (luxenos-software). It is not
# meant to be run by hand.
#
# Subcommands (everything else is rejected):
#   install-deb SHA256 /abs/path/file.deb   install one .deb through apt-get
#   update-lists                            apt-get update
#   enable-wine32                           add i386 + install wine32:i386
#   install PKG...                          apt-get install from the enabled
#                                           repositories (Software Center)
#   remove PKG...                           apt-get remove (keeps settings)
#   upgrade                                 apt-get --with-new-pkgs upgrade,
#                                           after a restore point when
#                                           updater.conf asks for one
#   repair                                  dpkg --configure -a; apt-get -f install
#   download-upgrades                       apt-get --download-only upgrade
#                                           (installed later, e.g. at shutdown
#                                           of the day or by the next upgrade)
#   security-upgrade                        unattended-upgrade (Debian-Security
#                                           origins only)
#   flatpak-update                          flatpak update, system installation
#   firmware-update                         fwupdmgr refresh + update (no reboot)
#   waydroid-upgrade                        newer waydroid package + Android
#                                           image (waydroid upgrade)
#   set-update-schedule KEY=VALUE...        update settings in updater.conf
#                                           (whitelisted keys/values) and the
#                                           automatic-update timer
#
# upgrade, security-upgrade and waydroid-upgrade first make a restore point
# (CREATE_BACKUP_BEFORE_UPDATE) and, on Btrfs, a snapshot
# (SNAPSHOT_BEFORE_UPDATE), as configured in /etc/luxenos/updater.conf.
# Every subcommand runs under one lock (/run/luxenos-pkg.lock), which
# luxenos-updater (automatic updates) takes as well: two package operations
# never run at the same time.
#
# Package names are checked against Debian's naming rules (at most 50 per
# call) and passed to apt-get after "--", never through a shell. Nothing
# here weakens apt: no option that accepts unauthenticated packages is ever
# passed, so packages from unsigned or untrusted repositories are refused by
# apt itself. An
# operation that would remove a package LuxenOS cannot run without (see
# PROTECTED) is refused before anything changes.
#
# Design rules:
#   * the .deb is read as the *calling user* (so this cannot be used to read
#     files the user could not read), copied into a root-owned staging dir and
#     checked against the SHA-256 the user confirmed, so what is installed is
#     exactly what was shown in the confirmation dialog;
#   * dependencies are resolved by apt-get, never by hand;
#   * nothing is hidden: apt/dpkg keep their normal logs, and every request is
#     also appended to /var/log/luxenos/pkg-helper.log and to the journal.
#
# Output protocol (read by the GUI): "@@STATUS text", "@@LOG text", plus
# apt's own Status-Fd lines (dlstatus:/pmstatus:).

set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
umask 022

LOGDIR=/var/log/luxenos
LOG=$LOGDIR/pkg-helper.log
LOCK=/run/luxenos-pkg.lock
CACHE=/var/cache/luxenos-pkg
MAX_DEB_BYTES=2147483648

if [ "$(id -u)" -ne 0 ]; then
    echo "@@LOG luxenos-pkg-root must run as root (through pkexec)."
    exit 1
fi

mkdir -p "$LOGDIR" "$CACHE"
chmod 755 "$LOGDIR" "$CACHE"
touch "$LOG"
chmod 644 "$LOG"

note() {
    printf '%s uid=%s %s\n' "$(date -Is)" "${PKEXEC_UID:-?}" "$*" >> "$LOG"
    logger -t luxenos-pkg -- "uid=${PKEXEC_UID:-?} $*" 2>/dev/null || true
}

status() { printf '@@STATUS %s\n' "$*"; }

fail() {
    printf '@@LOG ERROR: %s\n' "$*"
    note "FAILED: $*"
    exit 1
}

case ${PKEXEC_UID:-} in
    ''|*[!0-9]*) fail "must be started through pkexec" ;;
esac

exec 9>"$LOCK"
flock -w 180 9 || fail "another package operation is still running"

# run_apt ARGS... : apt output goes to the permanent log, progress lines
# (Status-Fd=3) go to stdout for the progress bar.
run_apt() {
    env DEBIAN_FRONTEND=noninteractive APT_LISTCHANGES_FRONTEND=none \
        apt-get -y -o APT::Status-Fd=3 -o DPkg::Lock::Timeout=120 \
        -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold \
        "$@" 3>&1 >>"$LOG" 2>&1
}

log_size() { wc -c < "$LOG"; }

report_failure() {
    tail -c +"$(( $1 + 1 ))" "$LOG" | tr '\r' '\n' | grep -v -e '^(Reading database' -e '^$' \
        | tail -n 40 | while IFS= read -r l; do
        printf '@@LOG %s\n' "$l"
    done
}

do_apt() {   # do_apt DESCRIPTION apt-args...
    desc=$1
    shift
    off=$(log_size)
    if run_apt "$@"; then
        note "OK: $desc"
        return 0
    else
        rc=$?
        report_failure "$off"
        note "apt-get failed (rc=$rc): $desc"
        exit "$rc"
    fi
}

do_install_deb() {
    want=$1
    src=$2
    case $want in
        ''|*[!0-9a-f]*) fail "bad checksum argument" ;;
    esac
    [ "${#want}" -eq 64 ] || fail "bad checksum argument"
    case $src in
        /*) ;;
        *) fail "package path must be absolute" ;;
    esac
    case $src in
        *'
'*) fail "invalid package path" ;;
    esac

    uid=$PKEXEC_UID
    gid=$(id -g "$uid") || fail "unknown user"
    asuser() { setpriv --reuid="$uid" --regid="$gid" --init-groups -- "$@"; }

    asuser test -f "$src" || fail "not a readable regular file: $src"
    size=$(asuser stat -L -c %s -- "$src") || fail "cannot read $src"
    [ "$size" -le "$MAX_DEB_BYTES" ] || fail "package is larger than 2 GiB"

    stage=$(mktemp -d "$CACHE/stage.XXXXXX")
    trap 'rm -rf "$stage"' EXIT
    chmod 755 "$stage"
    deb=$stage/package.deb

    asuser cat -- "$src" > "$deb" || fail "could not read $src"
    chmod 644 "$deb"

    got=$(sha256sum "$deb" | cut -d' ' -f1)
    [ "$got" = "$want" ] || fail "the file changed after it was confirmed; nothing was installed"

    dpkg-deb --field "$deb" Package >/dev/null 2>&1 || fail "not a valid Debian package"
    pkg=$(dpkg-deb -f "$deb" Package)
    ver=$(dpkg-deb -f "$deb" Version)
    case $pkg in
        [a-z0-9]*) ;;
        *) fail "invalid package name" ;;
    esac
    case $pkg in
        *[!a-z0-9+.-]*) fail "invalid package name" ;;
    esac

    note "install-deb package=$pkg version=$ver sha256=$got source=$src"
    status "Installing $pkg $ver..."
    do_apt "install $pkg $ver" install "$deb"
    status "Finished installing $pkg"
}

do_update_lists() {
    note "update-lists"
    status "Refreshing package lists..."
    do_apt "update" update
}

# Removing any of these would leave the user without a desktop, network,
# package manager or bootloader. Keep in sync with luxenos/pkg.py.
PROTECTED="sway swaybg swaylock swayidle waybar greetd wlgreet network-manager polkitd pkexec sudo systemd dbus apt dpkg python3 python3-gi python3-apt zenity linux-image-amd64 grub-pc grub-efi-amd64-bin foot"

check_names() {
    [ $# -ge 1 ] || fail "no package names given"
    [ $# -le 50 ] || fail "too many packages in one request"
    for n in "$@"; do
        case $n in
            [a-z0-9]?*) ;;
            *) fail "invalid package name: $n" ;;
        esac
        case $n in
            *[!a-z0-9+.:-]*|*-|*::*|*:) fail "invalid package name: $n" ;;
        esac
        [ "${#n}" -le 128 ] || fail "invalid package name: $n"
    done
}

# refuse_protected_removal APT-ARGS... : simulate first; fail if a protected
# package would be removed.
refuse_protected_removal() {
    sim=$(env LC_ALL=C.UTF-8 apt-get -s -q "$@" 2>&1) || {
        printf '%s\n' "$sim" | grep '^E:' | while IFS= read -r l; do printf '@@LOG %s\n' "$l"; done
        fail "apt-get cannot perform this operation"
    }
    removed=$(printf '%s\n' "$sim" | sed -n 's/^Remv \([^ ]*\).*/\1/p')
    for r in $removed; do
        for p in $PROTECTED; do
            [ "${r%%:*}" = "$p" ] && fail "refusing: this would remove the protected package $p"
        done
    done
    return 0
}

do_install_pkgs() {
    check_names "$@"
    note "install $*"
    refuse_protected_removal install -- "$@"
    status "Installing $*..."
    do_apt "install $*" install -- "$@"
    status "Finished installing $*"
}

do_remove_pkgs() {
    check_names "$@"
    note "remove $*"
    refuse_protected_removal remove -- "$@"
    status "Removing $*..."
    do_apt "remove $*" remove -- "$@"
    status "Finished removing $*"
}

UPDATER_CONF=/etc/luxenos/updater.conf

# conf_value KEY DEFAULT : one lowercase word from updater.conf.
conf_value() {
    v=$(sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*\"\{0,1\}\([a-z0-9:]*\).*/\1/p" \
        "$UPDATER_CONF" 2>/dev/null | tail -n 1)
    printf '%s\n' "${v:-$2}"
}

updater_wants_restore_point() { [ "$(conf_value CREATE_BACKUP_BEFORE_UPDATE yes)" = yes ]; }

# before_update DESCRIPTION : restore point and Btrfs snapshot, as configured.
# Neither failing stops the update; both are reported.
before_update() {
    if updater_wants_restore_point && [ -x /usr/libexec/luxenos/luxenos-restore-root ]; then
        status "Creating a restore point before updating..."
        if ! /usr/libexec/luxenos/luxenos-restore-root create --trigger update "$1" >>"$LOG" 2>&1; then
            printf '@@LOG %s\n' "WARNING: the restore point could not be created; continuing with the update."
            note "restore point before update FAILED"
        fi
    fi
    if [ "$(conf_value SNAPSHOT_BEFORE_UPDATE yes)" = yes ] && [ -x /usr/libexec/luxenos/luxenos-snapshot-root ] \
        && [ "$(findmnt -n -o FSTYPE / 2>/dev/null)" = btrfs ]; then
        status "Taking a Btrfs snapshot before updating..."
        if ! /usr/libexec/luxenos/luxenos-snapshot-root create --trigger update "$1" >>"$LOG" 2>&1; then
            printf '@@LOG %s\n' "WARNING: the Btrfs snapshot could not be created; continuing with the update."
            note "snapshot before update FAILED"
        fi
    fi
}

do_upgrade() {
    note "upgrade"
    refuse_protected_removal --with-new-pkgs upgrade
    before_update "Before software update"
    status "Installing updates..."
    do_apt "upgrade" --with-new-pkgs upgrade
    status "Finished installing updates"
}

do_download_upgrades() {
    note "download-upgrades"
    refuse_protected_removal --with-new-pkgs upgrade
    status "Downloading updates (nothing is installed yet)..."
    do_apt "download upgrades" --download-only --with-new-pkgs upgrade
    status "Updates downloaded; they are installed with the next update"
}

do_security_upgrade() {
    note "security-upgrade"
    command -v unattended-upgrade >/dev/null 2>&1 || fail "unattended-upgrades is not installed"
    before_update "Before security update"
    status "Installing security updates..."
    off=$(log_size)
    if ! env DEBIAN_FRONTEND=noninteractive unattended-upgrade -v >>"$LOG" 2>&1; then
        report_failure "$off"
        note "unattended-upgrade failed"
        exit 1
    fi
    note "OK: security-upgrade"
    status "Security updates installed"
}

do_flatpak_update() {
    note "flatpak-update"
    command -v flatpak >/dev/null 2>&1 || fail "Flatpak is not installed"
    status "Updating Flatpak applications (system)..."
    off=$(log_size)
    if ! flatpak update --system -y --noninteractive >>"$LOG" 2>&1; then
        report_failure "$off"
        note "flatpak update failed"
        exit 1
    fi
    note "OK: flatpak-update"
    status "Flatpak applications updated"
}

do_firmware_update() {
    note "firmware-update"
    command -v fwupdmgr >/dev/null 2>&1 || fail "fwupd is not installed"
    status "Refreshing firmware metadata..."
    # refresh exits 2 when the metadata is already current.
    rc=0
    fwupdmgr refresh --assume-yes >>"$LOG" 2>&1 || rc=$?
    if [ "$rc" -ne 0 ] && [ "$rc" -ne 2 ]; then
        fail "could not download firmware metadata (network?)"
    fi
    status "Installing firmware updates (the computer is not restarted automatically)..."
    off=$(log_size)
    rc=0
    fwupdmgr update --assume-yes --no-reboot-check >>"$LOG" 2>&1 || rc=$?
    case $rc in
        0) note "OK: firmware-update"; status "Firmware updated; restart to finish if asked" ;;
        2) note "firmware-update: nothing to do"; status "No firmware updates" ;;
        *) report_failure "$off"; note "fwupdmgr update failed (rc=$rc)"; exit 1 ;;
    esac
}

do_waydroid_upgrade() {
    note "waydroid-upgrade"
    command -v waydroid >/dev/null 2>&1 || fail "Waydroid is not installed"
    before_update "Before Android update"
    if dpkg-query -W -f='${db:Status-Status}' waydroid 2>/dev/null | grep -qx installed; then
        status "Updating the Waydroid package..."
        do_apt "upgrade waydroid" install --only-upgrade -- waydroid
    fi
    if [ -s /var/lib/waydroid/waydroid_base.prop ]; then
        status "Updating the Android image (waydroid upgrade)..."
        off=$(log_size)
        if ! waydroid upgrade >>"$LOG" 2>&1; then
            report_failure "$off"
            note "waydroid upgrade failed"
            exit 1
        fi
    else
        status "Android is not initialized yet; only the package was checked"
    fi
    note "OK: waydroid-upgrade"
    status "Android updated"
}

# set-update-schedule KEY=VALUE... : every pair is validated before anything
# is written; unknown keys or values change nothing.
set_conf_key() {   # set_conf_key KEY VALUE (validated by the caller)
    if grep -q "^[[:space:]]*$1[[:space:]]*=" "$UPDATER_CONF" 2>/dev/null; then
        sed -i "s|^[[:space:]]*$1[[:space:]]*=.*|$1=$2|" "$UPDATER_CONF"
    else
        printf '%s=%s\n' "$1" "$2" >> "$UPDATER_CONF"
    fi
}

do_set_update_schedule() {
    [ $# -ge 1 ] || fail "usage: set-update-schedule KEY=VALUE..."
    for kv in "$@"; do
        k=${kv%%=*}; v=${kv#*=}
        case $k in
            ENABLE_AUTO_UPDATES|DOWNLOAD_ONLY|AUTO_INSTALL_SECURITY|UPDATE_PACKAGES|UPDATE_FLATPAKS|\
            UPDATE_FIRMWARE|UPDATE_WAYDROID|UPDATES_ON_AC_ONLY|CREATE_BACKUP_BEFORE_UPDATE|\
            ENABLE_NOTIFICATIONS|NOTIFY_AVAILABLE|NOTIFY_COMPLETE|SNAPSHOT_BEFORE_UPDATE|SNAPSHOT_AUTO_PRUNE)
                case $v in yes|no) ;; *) fail "$k must be yes or no" ;; esac ;;
            AUTO_UPDATE_TIME)
                case $v in [01][0-9]:[0-5][0-9]|2[0-3]:[0-5][0-9]) ;; *) fail "AUTO_UPDATE_TIME must be HH:MM" ;; esac ;;
            SNAPSHOT_RETENTION|BACKUP_RETENTION)
                case $v in [1-9]|[1-9][0-9]) ;; *) fail "$k must be 1-99" ;; esac ;;
            *) fail "setting not allowed: $k" ;;
        esac
    done
    [ -f "$UPDATER_CONF" ] || fail "$UPDATER_CONF is missing"
    for kv in "$@"; do set_conf_key "${kv%%=*}" "${kv#*=}"; done
    note "set-update-schedule $*"
    t=$(conf_value AUTO_UPDATE_TIME 02:00)
    dropin=/etc/systemd/system/luxenos-auto-update.timer.d/luxenos-time.conf
    mkdir -p "$(dirname "$dropin")"
    printf '# Written by luxenos-pkg-root (Update Manager) from AUTO_UPDATE_TIME.\n[Timer]\nOnCalendar=\nOnCalendar=*-*-* %s:00\n' \
        "$t" > "$dropin"
    systemctl daemon-reload 2>/dev/null || true
    if [ "$(conf_value ENABLE_AUTO_UPDATES no)" = yes ]; then
        systemctl enable --now luxenos-auto-update.timer >/dev/null 2>&1 \
            || printf '@@LOG %s\n' "WARNING: could not enable luxenos-auto-update.timer"
    else
        systemctl disable --now luxenos-auto-update.timer >/dev/null 2>&1 || true
    fi
    status "Update settings saved"
}

do_repair() {
    note "repair"
    status "Finishing interrupted package operations..."
    off=$(log_size)
    if ! env DEBIAN_FRONTEND=noninteractive dpkg --configure -a \
        --force-confdef --force-confold >>"$LOG" 2>&1; then
        report_failure "$off"
        note "dpkg --configure -a failed"
        exit 1
    fi
    status "Fixing missing dependencies..."
    do_apt "fix-broken" -f install
    status "Repair finished"
}

do_enable_wine32() {
    [ "$(dpkg --print-architecture)" = amd64 ] || fail "32-bit support is only needed on amd64"
    note "enable-wine32"
    if ! dpkg --print-foreign-architectures | grep -qx i386; then
        dpkg --add-architecture i386
        note "added i386 architecture"
    fi
    status "Refreshing package lists..."
    do_apt "update (wine32)" update
    status "Installing 32-bit Windows support..."
    do_apt "install wine32:i386" install wine32:i386
    status "Finished"
}

case ${1:-} in
    install-deb)
        [ $# -eq 3 ] || fail "usage: install-deb SHA256 PATH"
        do_install_deb "$2" "$3"
        ;;
    update-lists)
        [ $# -eq 1 ] || fail "usage: update-lists"
        do_update_lists
        ;;
    enable-wine32)
        [ $# -eq 1 ] || fail "usage: enable-wine32"
        do_enable_wine32
        ;;
    install)
        shift
        do_install_pkgs "$@"
        ;;
    remove)
        shift
        do_remove_pkgs "$@"
        ;;
    upgrade)
        [ $# -eq 1 ] || fail "usage: upgrade"
        do_upgrade
        ;;
    repair)
        [ $# -eq 1 ] || fail "usage: repair"
        do_repair
        ;;
    download-upgrades|security-upgrade|flatpak-update|firmware-update|waydroid-upgrade)
        [ $# -eq 1 ] || fail "usage: $1"
        case $1 in
            download-upgrades) do_download_upgrades ;;
            security-upgrade) do_security_upgrade ;;
            flatpak-update) do_flatpak_update ;;
            firmware-update) do_firmware_update ;;
            waydroid-upgrade) do_waydroid_upgrade ;;
        esac
        ;;
    set-update-schedule)
        shift
        do_set_update_schedule "$@"
        ;;
    *)
        fail "unknown action"
        ;;
esac
