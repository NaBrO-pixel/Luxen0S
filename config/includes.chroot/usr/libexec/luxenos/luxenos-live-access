#!/bin/sh
# luxenos-live-access - live USB only: let the live user start the installer
# (/usr/local/bin/luxenos-installer) as root without a password.
#
# Run at boot by luxenos-live-access.service, before tty1 autologin. Writes,
# into the live system's RAM overlay only:
#   /etc/sudoers.d/luxenos-live-installer
#   /etc/polkit-1/rules.d/49-luxenos-live-installer.rules

set -eu

INSTALLER=/usr/local/bin/luxenos-installer
SUDOERS=/etc/sudoers.d/luxenos-live-installer
RULE=/etc/polkit-1/rules.d/49-luxenos-live-installer.rules

log() { echo "luxenos-live-access: $*" >&2; }

if ! grep -qw 'boot=live' /proc/cmdline 2>/dev/null || [ ! -d /run/live ]; then
    log "not a live boot; nothing to do"
    exit 0
fi

USERNAME_FILE=/etc/luxenos-installer/live-username
if [ ! -r "$USERNAME_FILE" ]; then
    log "ERROR: expected live username file is missing; refusing to grant access"
    exit 1
fi
expected_user=$(cat "$USERNAME_FILE")
case "$expected_user" in
    ''|root|-*|*[!a-z0-9_-]*)
        log "ERROR: invalid configured live username '$expected_user'"
        exit 1
        ;;
esac

user=$expected_user
set -f
for p in $(cat /proc/cmdline); do
    case $p in
        username=*|live-config.username=*)
            candidate=${p#*username=}
            if [ "$candidate" != "$expected_user" ]; then
                log "ERROR: refusing live username '$candidate' (expected '$expected_user')"
                exit 1
            fi
            user=$candidate
            ;;
    esac
done
set +f

if [ ! -x "$INSTALLER" ]; then
    log "ERROR: installer command is missing or not executable: $INSTALLER"
    exit 1
fi

# Never install a sudoers rule unless visudo is available and accepts it.
if ! command -v visudo >/dev/null 2>&1; then
    log "ERROR: visudo is unavailable; refusing to write sudoers rule"
    exit 1
fi
mkdir -p /etc/sudoers.d
tmp=$(mktemp /etc/sudoers.d/.luxenos-live-installer.XXXXXX)
trap 'rm -f "$tmp"' EXIT HUP INT TERM
printf '# Live USB only, written at boot by luxenos-live-access.\n%s ALL=(root) NOPASSWD: %s\n' \
    "$user" "$INSTALLER" > "$tmp"
chmod 0440 "$tmp"
if ! visudo -cqf "$tmp"; then
    log "ERROR: generated sudoers rule failed visudo -c"
    exit 1
fi
mv -f "$tmp" "$SUDOERS"
trap - EXIT HUP INT TERM
log "sudo rule for '$user' -> $INSTALLER installed"

mkdir -p /etc/polkit-1/rules.d
cat > "$RULE.tmp" <<RULES
// Live USB only, written at boot by luxenos-live-access.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.policykit.exec" &&
        action.lookup("program") == "$INSTALLER" &&
        subject.user == "$user" && subject.local) {
        return polkit.Result.YES;
    }
});
RULES
chmod 0644 "$RULE.tmp"
mv -f "$RULE.tmp" "$RULE"
log "polkit rule for '$user' -> $INSTALLER installed"
