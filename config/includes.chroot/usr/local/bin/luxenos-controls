#!/bin/sh
# Quick system controls in the glass launcher (Super+C, or the gear in Waybar).
# Pure wofi menu: no terminal, no extra daemon.

MENU_PROMPT="Controls"

pick() {
    # pick PROMPT LINES  (items on stdin)
    wofi --show dmenu --prompt "$1" --lines "$2" --width 360 \
        --insensitive --cache-file /dev/null
}

confirm() {
    ans=$(printf 'Yes\nNo\n' | pick "$1" 2)
    [ "$ans" = "Yes" ]
}

accessibility_settings() {
    if ! command -v zenity >/dev/null 2>&1; then
        printf 'Accessibility settings need zenity.\n' >&2
        return 1
    fi
    current=$(luxenos-glass get intensity 2>/dev/null || printf '55')
    case $current in ''|*[!0-9]*) current=55 ;; esac
    value=$(zenity --scale \
        --title="Settings — Accessibility" \
        --text="Liquid Glass intensity\n\nLess glass is more opaque and lighter on graphics. More glass adds translucency, blur, rounded corners, and shadows when SwayFX is available." \
        --min-value=0 --max-value=100 --value="$current" --step=1 \
        --width=480 --ok-label="Apply" 2>/dev/null) || return 0
    case $value in ''|*[!0-9]*) return 0 ;; esac
    luxenos-glass intensity "$value" || {
        zenity --error --title="Accessibility settings" --text="Could not apply Liquid Glass intensity." 2>/dev/null
        return 1
    }
    zenity --info --title="Accessibility settings" --text="Liquid Glass intensity set to $value%.\n\nIf blur is unavailable, LuxenOS keeps panels more opaque for readability." 2>/dev/null || true
}

if [ "${1:-}" = accessibility ]; then
    accessibility_settings
    exit $?
fi

choice=$(cat <<'ITEMS' | pick "$MENU_PROMPT" 16
Network & Wi-Fi
Sound
Appearance (GTK theme)
Settings: Accessibility
Glass: Performance
Glass: Balanced
Glass: Rich
Glass: Flat (no glass)
Theme: Dark
Theme: Light
Power profile
Lock screen
Log out
Restart
Shut down
ITEMS
)

case $choice in
    "Network & Wi-Fi")          exec luxenos-network ;;
    "Sound")                    exec pavucontrol-qt ;;
    "Appearance (GTK theme)")   exec nwg-look ;;
    "Settings: Accessibility")  exec luxenos-controls accessibility ;;
    "Glass: Performance")       exec luxenos-glass preset performance ;;
    "Glass: Balanced")          exec luxenos-glass preset balanced ;;
    "Glass: Rich")              exec luxenos-glass preset rich ;;
    "Glass: Flat (no glass)")   exec luxenos-glass preset flat ;;
    "Theme: Dark")              exec luxenos-glass theme dark ;;
    "Theme: Light")             exec luxenos-glass theme light ;;
    "Power profile")            exec luxenos-power-profile-cycle ;;
    "Lock screen")              exec luxenos-lock ;;
    "Log out")     confirm "Log out?"   && exec swaymsg exit ;;
    "Restart")     confirm "Restart?"   && exec systemctl reboot ;;
    "Shut down")   confirm "Shut down?" && exec systemctl poweroff ;;
esac
exit 0
