#!/bin/sh
# Cycles balanced -> powersave -> performance -> balanced ... and asks TLP to
# apply the corresponding mode through luxenos-power-profile-root (pkexec,
# no password for the active local session). Falls back to just recording the
# preference if tlp isn't installed, so this stays safe to run on any session.

set -eu

STATE_FILE="${LUXENOS_POWER_STATE_FILE:-$HOME/.cache/luxenos-power-profile}"
mkdir -p "$(dirname "$STATE_FILE")"

current="balanced"
[ -f "$STATE_FILE" ] && current="$(cat "$STATE_FILE")"

case "$current" in
    balanced)    next="powersave" ;;
    powersave)   next="performance" ;;
    performance) next="balanced" ;;
    *)           next="balanced" ;;
esac

echo "$next" > "$STATE_FILE"

HELPER=/usr/libexec/luxenos/luxenos-power-profile-root
if command -v tlp >/dev/null 2>&1 && [ -x "$HELPER" ]; then
    case "$next" in
        powersave)   mode=bat ;;
        performance) mode=ac ;;
        *)           mode=start ;;
    esac
    if ! pkexec "$HELPER" "$mode" >/dev/null 2>&1; then
        command -v notify-send >/dev/null 2>&1 \
            && notify-send -a LuxenOS "Power profile not applied" \
                "TLP could not be switched to $next." >/dev/null 2>&1
    fi
fi

command -v pkill >/dev/null 2>&1 && pkill -RTMIN+8 waybar >/dev/null 2>&1 || true
