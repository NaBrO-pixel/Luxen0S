#!/bin/sh
# Accessible, graphical controls for Liquid Glass and motion preferences.
set -u

if ! command -v zenity >/dev/null 2>&1; then
    printf '%s\n' "LuxenOS Accessibility Settings requires zenity." >&2
    exit 1
fi

get_value() {
    luxenos-glass get "$1" 2>/dev/null | tail -n 1
}

while :; do
    intensity=$(get_value intensity)
    case $intensity in ''|*[!0-9]*) intensity=55 ;; esac
    motion=$(get_value reduce_motion)
    case $motion in yes) motion_label="Reduce motion: On" ;; *) motion_label="Reduce motion: Off" ;; esac

    choice=$(zenity --list --title="LuxenOS Settings — Accessibility" \
        --text="Adjust Liquid Glass strength and motion effects. Lower glass intensity uses fewer visual effects and is usually easier to read." \
        --column="Setting" --column="Current value" \
        "Liquid Glass intensity" "${intensity}%" \
        "$motion_label" "Toggle" \
        "Reset Liquid Glass" "Balanced default" \
        --width=520 --height=330 2>/dev/null) || exit 0

    case "$choice" in
        "Liquid Glass intensity")
            value=$(zenity --scale --title="Liquid Glass intensity" \
                --text="Less glass ←  More glass
0% = flat and minimal; 100% = strong blur, translucency, rounded corners and shadows." \
                --min-value=0 --max-value=100 --value="$intensity" --step=1 --width=520 \
                2>/dev/null) || continue
            case $value in ''|*[!0-9]*) continue ;; esac
            luxenos-glass intensity "$value" || zenity --error --title="Accessibility Settings" --text="Could not apply Liquid Glass settings." 2>/dev/null
            ;;
        "Reduce motion: On"|"Reduce motion: Off")
            if [ "$motion" = yes ]; then
                luxenos-glass set GLASS_REDUCE_MOTION no
            else
                luxenos-glass set GLASS_REDUCE_MOTION yes
            fi
            ;;
        "Reset Liquid Glass")
            luxenos-glass preset balanced
            ;;
        *) exit 0 ;;
    esac
done
