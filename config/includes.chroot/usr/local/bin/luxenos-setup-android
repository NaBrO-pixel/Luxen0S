#!/bin/sh
# luxenos-setup-android - wait for Waydroid's first initialization and start it.

set -u
APK=/usr/share/luxenos/apks/AuroraStore.apk
BASE_PROP=/var/lib/waydroid/waydroid_base.prop

echo
echo "=== LuxenOS: Android setup ==="
echo

if ! command -v waydroid >/dev/null 2>&1; then
    echo "Waydroid is not installed on this system."
    exit 1
fi

if [ ! -s "$BASE_PROP" ]; then
    echo "Waiting for first-boot Waydroid initialization (up to 10 minutes)..."
    waited=0
    while [ "$waited" -lt 600 ] && [ ! -s "$BASE_PROP" ]; do
        if command -v systemctl >/dev/null 2>&1 &&
           systemctl is-failed --quiet waydroid-first-init.service; then
            echo "Waydroid initialization failed."
            echo "Check: sudo systemctl status waydroid-first-init.service"
            echo "Logs: sudo journalctl -u waydroid-first-init.service"
            exit 1
        fi
        sleep 5
        waited=$((waited + 5))
    done
    if [ ! -s "$BASE_PROP" ]; then
        echo "Waydroid is not initialized yet."
        echo "Check: sudo systemctl status waydroid-first-init.service"
        echo "Logs: sudo journalctl -u waydroid-first-init.service"
        exit 1
    fi
fi

echo "Starting Waydroid session..."
if ! waydroid session start; then
    echo "Could not start the Waydroid session."
    echo "Check: waydroid status"
    echo "Logs: waydroid log"
    exit 1
fi

attempt=0
while [ "$attempt" -lt 30 ]; do
    status=$(waydroid status 2>&1 || true)
    if printf '%s\n' "$status" | grep -qiE 'Session:[[:space:]]*RUNNING'; then
        break
    fi
    sleep 2
    attempt=$((attempt + 1))
done
if [ "$attempt" -ge 30 ]; then
    echo "Waydroid session did not reach RUNNING state."
    waydroid status || true
    echo "Check logs with: waydroid log"
    exit 1
fi

echo "Waydroid session is running."
if [ -f "$APK" ]; then
    echo "Installing Aurora Store..."
    if waydroid app install "$APK"; then
        echo "Aurora Store installed. Open it from the Waydroid UI."
    else
        echo "Aurora Store installation failed."
        echo "Retry with: waydroid app install $APK"
        exit 1
    fi
else
    echo "Aurora Store was not bundled in this image."
    echo "The Android container is ready; no APK installation was attempted."
fi
