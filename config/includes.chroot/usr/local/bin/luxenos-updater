#!/bin/bash
#
# LuxenOS System Updater
# Handles package updates, security patches, and system maintenance
#
# Usage:
#   luxenos-updater                    # Interactive mode
#   luxenos-updater --auto             # Automatic mode (unattended)
#   luxenos-updater --check            # Check for updates without installing
#   luxenos-updater --rollback         # Rollback to previous system state
#

set -e

# ============================================================================
# Configuration
# ============================================================================

LUXENOS_VERSION_FILE="/etc/luxenos-version"
LUXENOS_UPDATE_LOG="/var/log/luxenos-updates.log"
LUXENOS_BACKUP_DIR="/var/backups/luxenos"
LUXENOS_UPDATE_CACHE="/var/cache/luxenos-updates"

LUXENOS_UPDATER_CONF="/etc/luxenos/updater.conf"

# Create necessary directories
mkdir -p "$LUXENOS_BACKUP_DIR" "$LUXENOS_UPDATE_CACHE"

# Settings from updater.conf (changed with luxenos-update-settings). The file
# is parsed, never sourced; unknown keys and invalid values are ignored.
UPDATE_PACKAGES=yes
UPDATE_WAYDROID=yes
UPDATE_FLATPAKS=yes
UPDATE_FIRMWARE=yes
AUTO_INSTALL_SECURITY=yes
CREATE_BACKUP_BEFORE_UPDATE=yes
BACKUP_RETENTION=5
UPDATES_ON_AC_ONLY=yes

load_updater_conf() {
    [ -r "$LUXENOS_UPDATER_CONF" ] || return 0
    local line key val
    while IFS= read -r line || [ -n "$line" ]; do
        case $line in ''|'#'*) continue ;; esac
        key=${line%%=*}
        val=${line#*=}
        val=${val%%#*}
        val=${val//[[:space:]]/}
        val=${val#\"}
        val=${val%\"}
        case $key in
            UPDATE_PACKAGES|UPDATE_WAYDROID|UPDATE_FLATPAKS|UPDATE_FIRMWARE|\
            AUTO_INSTALL_SECURITY|CREATE_BACKUP_BEFORE_UPDATE|UPDATES_ON_AC_ONLY)
                case $val in yes|no) printf -v "$key" '%s' "$val" ;; esac ;;
            BACKUP_RETENTION)
                case $val in ''|*[!0-9]*|0) ;; *) BACKUP_RETENTION=$val ;; esac ;;
        esac
    done < "$LUXENOS_UPDATER_CONF"
}
load_updater_conf

# ============================================================================
# Colors and Output
# ============================================================================

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

log_info() {
    echo -e "${GREEN}[INFO]${NC} $*" | tee -a "$LUXENOS_UPDATE_LOG"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $*" | tee -a "$LUXENOS_UPDATE_LOG"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $*" | tee -a "$LUXENOS_UPDATE_LOG"
}

log_section() {
    echo -e "\n${BLUE}=== $* ===${NC}" | tee -a "$LUXENOS_UPDATE_LOG"
}

# run_logged CMD... : run CMD with its output shown and appended to the log,
# returning CMD's own exit status (a plain "cmd | tee" pipeline would return
# tee's, so failures went unnoticed).
run_logged() {
    "$@" 2>&1 | tee -a "$LUXENOS_UPDATE_LOG"
    return "${PIPESTATUS[0]}"
}

# True when running on battery: a battery is present and no AC adapter is
# online. Desktops (no battery) always count as on AC.
on_battery() {
    local ps have_battery=no
    for ps in /sys/class/power_supply/*; do
        [ -r "$ps/type" ] || continue
        case $(cat "$ps/type") in
            Mains|USB|USB_C|USB_PD)
                [ "$(cat "$ps/online" 2>/dev/null)" = 1 ] && return 1 ;;
            Battery) have_battery=yes ;;
        esac
    done
    [ "$have_battery" = yes ]
}

progress_bar() {
    local current=$1
    local total=$2
    local width=40
    local percent=$((current * 100 / total))
    local filled=$((percent * width / 100))
    
    printf "["
    printf "%${filled}s" | tr ' ' '='
    printf "%$((width - filled))s" | tr ' ' '-'
    printf "] %d%%\r" "$percent"
}

# ============================================================================
# Pre-flight Checks
# ============================================================================

check_prerequisites() {
    log_section "Checking Prerequisites"
    
    # Check if running as root
    if [ "$EUID" -ne 0 ]; then
        log_error "This updater requires root privileges. Use sudo."
        exit 1
    fi
    
    # Check internet connectivity
    if ! ping -c 1 -W 2 deb.debian.org >/dev/null 2>&1; then
        log_warn "Internet connectivity check failed. Some updates may not work."
    fi
    
    # Check disk space (need at least 1GB free)
    available_kb=$(df / | awk 'NR==2 {print $4}')
    available_mb=$((available_kb / 1024))
    if [ "$available_mb" -lt 1000 ]; then
        log_error "Insufficient disk space: ${available_mb}MB available (need 1000MB+)"
        exit 1
    fi
    log_info "Disk space: ${available_mb}MB available ✓"
    
    # Check if package manager is available
    if ! command -v apt-get >/dev/null 2>&1; then
        log_error "apt-get not found. Cannot proceed."
        exit 1
    fi
    log_info "Package manager available ✓"
}

# ============================================================================
# Backup Management
# ============================================================================

create_backup() {
    log_section "Creating System Backup"
    
    local backup_name
    backup_name="luxenos-backup-$(date +%Y%m%d-%H%M%S)"
    local backup_path="$LUXENOS_BACKUP_DIR/$backup_name"
    
    mkdir -p "$backup_path"
    
    # Backup package list
    log_info "Backing up package list..."
    dpkg --get-selections > "$backup_path/packages.list"
    apt-mark showmanual > "$backup_path/manual-packages.list"
    
    # Backup /etc directory (critical configs)
    log_info "Backing up system configuration..."
    tar -czf "$backup_path/etc-backup.tar.gz" \
        --exclude='/etc/luxenos-installer' \
        --exclude='/etc/calamares' \
        /etc 2>/dev/null || log_warn "Could not backup all /etc files"
    
    # Backup sway/desktop configs
    log_info "Backing up user configurations..."
    if [ -d /etc/skel/.config ]; then
        tar -czf "$backup_path/skel-config-backup.tar.gz" /etc/skel/.config
    fi
    
    # Create metadata
    cat > "$backup_path/backup-metadata.txt" << EOF
Backup Date: $(date)
LuxenOS Version: $(cat "$LUXENOS_VERSION_FILE" 2>/dev/null || echo "unknown")
Kernel: $(uname -r)
Hostname: $(hostname)
Disk Space Used: $(du -sh / 2>/dev/null | cut -f1)
EOF
    
    # Keep only the last BACKUP_RETENTION backups to save space
    ls -t "${LUXENOS_BACKUP_DIR:?}" | tail -n +$((BACKUP_RETENTION + 1)) | while IFS= read -r old_backup; do
        [ -n "$old_backup" ] || continue
        log_warn "Removing old backup: $old_backup"
        rm -rf "${LUXENOS_BACKUP_DIR:?}/$old_backup"
    done
    
    log_info "✓ Backup created: $backup_path"
    echo "$backup_path"
}

# ============================================================================
# Package Updates
# ============================================================================

update_package_cache() {
    log_section "Updating Package Cache"
    
    if ! run_logged apt-get update; then
        log_error "Failed to update package cache"
        return 1
    fi
    
    log_info "✓ Package cache updated"
}

check_available_updates() {
    log_section "Checking Available Updates"
    
    local updates
    
    updates=$(apt-get upgrade -s 2>/dev/null | grep "^Inst" | wc -l)
    local security_updates
    security_updates=$(apt-get upgrade -s 2>/dev/null | grep "^Inst.*Security" | wc -l)
    
    echo "$updates"
    log_info "Available package updates: $updates"
    log_info "Security updates: $security_updates"
}

list_available_updates() {
    log_section "Packages Available for Update"
    
    apt-get upgrade -s 2>/dev/null | grep "^Inst" | \
        awk '{print $2 " (" $4 " -> " $5 ")"}' | \
        tee -a "$LUXENOS_UPDATE_LOG"
}

# Security updates only: unattended-upgrade installs exactly the origins in
# /etc/apt/apt.conf.d/50unattended-upgrades (Debian-Security by default).
install_security_updates() {
    log_info "Installing security updates..."
    if ! command -v unattended-upgrade >/dev/null 2>&1; then
        log_warn "unattended-upgrade is not installed; security updates come with the standard updates"
        return 0
    fi
    if ! run_logged unattended-upgrade -v; then
        log_error "Security update installation failed"
        return 1
    fi
    log_info "✓ Security updates installed"
}

perform_upgrade() {
    log_section "Installing Package Updates"
    
    # First: security updates
    if [ "$AUTO_INSTALL_SECURITY" = yes ]; then
        install_security_updates || return 1
    fi
    
    # Second: everything else. --with-new-pkgs lets upgrades pull in new
    # packages (e.g. the new linux-image-* a kernel update depends on) without
    # ever removing anything; a plain "upgrade" holds those back for good.
    log_info "Installing standard updates..."
    if ! DEBIAN_FRONTEND=noninteractive run_logged apt-get upgrade --with-new-pkgs -y -qq; then
        log_error "Package upgrade failed"
        return 1
    fi
    
    log_info "✓ All packages updated"
}

# ============================================================================
# Waydroid Updates
# ============================================================================

update_waydroid() {
    log_section "Checking Waydroid Updates"
    
    if ! command -v waydroid >/dev/null 2>&1; then
        log_warn "Waydroid not installed, skipping Waydroid update"
        return 0
    fi
    
    local current_version
    
    current_version=$(waydroid --version 2>/dev/null || echo "unknown")
    log_info "Current Waydroid version: $current_version"
    
    # Check for Waydroid package updates
    if apt-get upgrade -s 2>/dev/null | grep -q "^Inst waydroid"; then
        log_info "Waydroid update available"
        if [ "$AUTO_MODE" != "1" ]; then
            read -r -p "Install Waydroid update? (y/n) " -n 1
            echo
            if [[ ! $REPLY =~ ^[Yy]$ ]]; then
                log_warn "Skipping Waydroid update"
                return 0
            fi
        fi
        
        log_info "Installing Waydroid update..."
        if ! DEBIAN_FRONTEND=noninteractive run_logged apt-get install -y --only-upgrade waydroid; then
            log_error "Waydroid update failed"
            return 1
        fi
        log_info "✓ Waydroid updated"
    else
        log_info "Waydroid is up to date"
    fi
}

# ============================================================================
# Flatpak Updates
# ============================================================================

update_flatpaks() {
    log_section "Checking Flatpak Updates"
    
    if ! command -v flatpak >/dev/null 2>&1; then
        log_warn "Flatpak not installed, skipping Flatpak updates"
        return 0
    fi
    
    log_info "Updating Flatpak remotes..."
    if ! flatpak remote-ls --app 2>/dev/null | head -5 > /dev/null; then
        log_warn "Flatpak not properly configured, skipping"
        return 0
    fi
    
    log_info "Checking for Flatpak app updates..."
    if flatpak update --appstream 2>&1 | tee -a "$LUXENOS_UPDATE_LOG"; then
        log_info "✓ Flatpak remotes updated"
    else
        log_warn "Could not update Flatpak remotes"
    fi
}

# ============================================================================
# System Health Checks
# ============================================================================

check_system_health() {
    log_section "System Health Check"
    
    # Check broken dependencies
    if run_logged apt-get check; then
        log_info "✓ No broken dependencies"
    else
        log_error "Broken dependencies detected"
        log_info "Running: apt-get --fix-broken install"
        if ! DEBIAN_FRONTEND=noninteractive run_logged apt-get --fix-broken install -y; then
            log_error "Could not fix broken dependencies automatically"
        fi
    fi
    
    # Clean up unused packages
    local orphaned
    orphaned=$(apt-get autoremove --dry-run 2>/dev/null | grep "^Remov" | wc -l)
    if [ "$orphaned" -gt 0 ]; then
        log_info "Found $orphaned orphaned packages"
        if [ "$AUTO_MODE" != "1" ]; then
            read -r -p "Remove orphaned packages? (y/n) " -n 1
            echo
            if [[ $REPLY =~ ^[Yy]$ ]]; then
                log_info "Removing orphaned packages..."
                apt-get autoremove -y 2>&1 | tee -a "$LUXENOS_UPDATE_LOG"
            fi
        else
            log_info "Removing orphaned packages in auto mode..."
            apt-get autoremove -y 2>&1 | tee -a "$LUXENOS_UPDATE_LOG"
        fi
    else
        log_info "✓ No orphaned packages"
    fi
    
    # Verify filesystem integrity
    # e2fsck cannot check a mounted filesystem; the kernel records errors it
    # hit in the ext4 superblock instead, which tune2fs can read while mounted.
    log_info "Checking filesystem integrity..."
    local root_dev root_fs fs_info
    root_dev=$(findmnt -n -o SOURCE / 2>/dev/null || true)
    root_fs=$(findmnt -n -o FSTYPE / 2>/dev/null || true)
    case $root_fs in
        ext2|ext3|ext4)
            if command -v tune2fs >/dev/null 2>&1 && fs_info=$(tune2fs -l "$root_dev" 2>/dev/null); then
                if printf '%s\n' "$fs_info" | grep -q '^Filesystem state:.*error' \
                    || printf '%s\n' "$fs_info" | grep -Eq '^FS Error count:[[:space:]]*[1-9]'; then
                    log_warn "The root filesystem has recorded errors; run fsck on next boot (touch /forcefsck)"
                else
                    log_info "✓ No filesystem errors recorded"
                fi
            else
                log_warn "Could not read the root filesystem state ($root_dev)"
            fi
            ;;
        *) log_info "Root filesystem is ${root_fs:-unknown}; integrity check skipped" ;;
    esac
}

# ============================================================================
# Kernel Updates
# ============================================================================

check_kernel_updates() {
    log_section "Checking Kernel Updates"
    
    local current_kernel
    
    current_kernel=$(uname -r)
    log_info "Current kernel: $current_kernel"
    
    # Check for newer kernel packages
    if apt-cache policy linux-image-amd64 2>/dev/null | grep -q "Candidate"; then
        log_info "Kernel updates may be available"
        if [ "$AUTO_MODE" != "1" ]; then
            read -r -p "Check detailed kernel update info? (y/n) " -n 1
            echo
            if [[ $REPLY =~ ^[Yy]$ ]]; then
                apt-cache policy linux-image-amd64 2>/dev/null | tee -a "$LUXENOS_UPDATE_LOG"
            fi
        fi
    else
        log_info "Kernel is up to date"
    fi
}

# ============================================================================
# Firmware Updates
# ============================================================================

update_firmware() {
    log_section "Checking Firmware Updates"
    
    if ! command -v fwupdmgr >/dev/null 2>&1; then
        log_warn "fwupdmgr not installed, skipping firmware updates"
        return 0
    fi
    
    log_info "Checking for firmware updates..."
    # fwupdmgr refresh exits 2 when the metadata is already current.
    local rc=0
    run_logged fwupdmgr refresh --assume-yes || rc=$?
    if [ "$rc" -ne 0 ] && [ "$rc" -ne 2 ]; then
        log_warn "Could not refresh firmware metadata"
        return 0
    fi
    
    # get-updates exits 0 only when updates are available (2 = none).
    if run_logged fwupdmgr get-updates --assume-yes; then
        log_info "Firmware updates available"
        if [ "$AUTO_MODE" != "1" ]; then
            read -r -p "Install firmware updates? (y/n) " -n 1
            echo
            if [[ ! $REPLY =~ ^[Yy]$ ]]; then
                log_warn "Skipping firmware updates"
                return 0
            fi
        fi
        
        log_info "Installing firmware updates..."
        # --assume-yes: no prompts (there is no terminal in auto mode);
        # --no-reboot-check: a needed reboot is left to the user.
        if run_logged fwupdmgr update --assume-yes --no-reboot-check; then
            log_info "✓ Firmware updated"
        else
            log_error "Firmware update failed"
        fi
    else
        log_info "Firmware is up to date"
    fi
}

# ============================================================================
# System Cleanup
# ============================================================================

cleanup_system() {
    log_section "System Cleanup"
    
    # Remove package cache
    local cache_size
    cache_size=$(du -sh /var/cache/apt 2>/dev/null | cut -f1)
    log_info "Removing old package cache ($cache_size)..."
    apt-get autoclean -y 2>&1 | tee -a "$LUXENOS_UPDATE_LOG"
    
    # Clear temporary files
    log_info "Clearing temporary files..."
    find /tmp -type f -atime +7 -delete 2>/dev/null || true
    find /var/tmp -type f -atime +7 -delete 2>/dev/null || true
    
    # Clear old logs
    log_info "Clearing old logs..."
    journalctl --vacuum=30d 2>/dev/null || true
    
    # Check disk usage after cleanup
    local used_space
    used_space=$(df / | awk 'NR==2 {printf "%.1f", $3/1024/1024}')
    log_info "✓ Cleanup complete (disk usage: ${used_space}GB)"
}

# ============================================================================
# Rollback Functionality
# ============================================================================

list_available_backups() {
    log_section "Available Backups"
    
    if [ ! -d "$LUXENOS_BACKUP_DIR" ] || [ -z "$(ls -A "$LUXENOS_BACKUP_DIR")" ]; then
        log_error "No backups found"
        return 1
    fi
    
    # Newest first, numbered in the same order rollback_system selects by.
    ls -t "$LUXENOS_BACKUP_DIR" | awk '{print NR ": " $0}' | \
        tee -a "$LUXENOS_UPDATE_LOG"
}

rollback_system() {
    log_section "System Rollback"
    
    if ! list_available_backups; then
        return 1
    fi
    
    log_warn "WARNING: Rollback will restore system state from backup"
    log_warn "WARNING: Changes made after backup will be lost"
    read -r -p "Continue with rollback? (yes/no) " response
    if [ "$response" != "yes" ]; then
        log_info "Rollback cancelled"
        return 0
    fi
    
    read -r -p "Select backup number to restore: " backup_num
    case $backup_num in
        ''|*[!0-9]*|0) log_error "Invalid backup selection"; return 1 ;;
    esac
    
    # Get the Nth backup (POSIX compatible)
    local backup_to_restore
    backup_to_restore=$(ls -t "$LUXENOS_BACKUP_DIR" | sed -n "${backup_num}p")
    
    if [ -z "$backup_to_restore" ]; then
        log_error "Invalid backup selection"
        return 1
    fi
    
    local backup_path="$LUXENOS_BACKUP_DIR/$backup_to_restore"
    
    log_warn "Restoring from: $backup_path"
    log_info "Restoring package list..."
    if [ -f "$backup_path/packages.list" ]; then
        dpkg --set-selections < "$backup_path/packages.list"
        apt-get dselect-upgrade -y 2>&1 | tee -a "$LUXENOS_UPDATE_LOG"
    fi
    
    # Accounts, passwords and the machine identity are never rolled back:
    # restoring them would undo password changes and break users created
    # since the backup (their homes and files would lose their owner).
    log_info "Restoring /etc configuration (accounts and passwords are kept)..."
    if [ -f "$backup_path/etc-backup.tar.gz" ]; then
        tar -xzf "$backup_path/etc-backup.tar.gz" -C / \
            --exclude='etc/passwd' --exclude='etc/passwd-' \
            --exclude='etc/shadow' --exclude='etc/shadow-' \
            --exclude='etc/group' --exclude='etc/group-' \
            --exclude='etc/gshadow' --exclude='etc/gshadow-' \
            --exclude='etc/subuid' --exclude='etc/subuid-' \
            --exclude='etc/subgid' --exclude='etc/subgid-' \
            --exclude='etc/machine-id' \
            2>/dev/null || \
            log_warn "Could not restore all /etc files"
    fi
    
    log_info "Restoring sway/desktop configs..."
    if [ -f "$backup_path/skel-config-backup.tar.gz" ]; then
        tar -xzf "$backup_path/skel-config-backup.tar.gz" -C / 2>/dev/null || \
            log_warn "Could not restore all config files"
    fi
    
    log_info "✓ Rollback complete"
    log_warn "Please reboot for all changes to take effect"
}

# ============================================================================
# Update Report
# ============================================================================

generate_report() {
    log_section "Update Report"
    
    cat << EOF | tee -a "$LUXENOS_UPDATE_LOG"

═══════════════════════════════════════════════════════════════
                    LuxenOS Update Report
═══════════════════════════════════════════════════════════════

Update Date: $(date)
Hostname: $(hostname)
LuxenOS Version: $(cat "$LUXENOS_VERSION_FILE" 2>/dev/null || echo "unknown")

System Information:
  Kernel: $(uname -r)
  CPU: $(nproc) cores
  Memory: $(free -h | awk 'NR==2 {print $2}')
  Disk Used: $(df / | awk 'NR==2 {printf "%.1f%%", $3/($3+$4)*100}')

Update Statistics:
  Total Packages: $(dpkg -l | grep "^ii" | wc -l)
  Upgradeable Packages: $(apt-get upgrade -s 2>/dev/null | grep "^Inst" | wc -l)
  Last Update: $(stat -c %y "$LUXENOS_UPDATE_LOG" 2>/dev/null | cut -d' ' -f1-2)

═══════════════════════════════════════════════════════════════

Full log: $LUXENOS_UPDATE_LOG

EOF
}

# ============================================================================
# Main Menu
# ============================================================================

show_menu() {
    echo ""
    echo "╔════════════════════════════════════════════╗"
    echo "║        LuxenOS System Updater              ║"
    echo "╚════════════════════════════════════════════╝"
    echo ""
    echo "1. Check for updates"
    echo "2. Install all updates"
    echo "3. Install security updates only"
    echo "4. List available updates"
    echo "5. Update Waydroid"
    echo "6. Update Flatpaks"
    echo "7. Full system maintenance"
    echo "8. View update history"
    echo "9. Create backup"
    echo "10. Rollback system"
    echo "11. Generate report"
    echo "0. Exit"
    echo ""
}

# ============================================================================
# Main Logic
# ============================================================================

main() {
    # Parse command line arguments
    AUTO_MODE=0
    CHECK_ONLY=0
    
    while [[ $# -gt 0 ]]; do
        case $1 in
            --auto)
                AUTO_MODE=1
                shift
                ;;
            --check)
                CHECK_ONLY=1
                shift
                ;;
            --rollback)
                check_prerequisites
                rollback_system
                exit $?
                ;;
            --help)
                cat << EOF
LuxenOS Updater - System Update Management

Usage:
  luxenos-updater                   Interactive mode
  luxenos-updater --auto            Automatic updates
  luxenos-updater --check           Check without installing
  luxenos-updater --rollback        Rollback to previous backup

Options:
  --auto                            Install updates automatically
  --check                           Check for updates only
  --rollback                        Rollback system state
  --help                            Show this help message

EOF
                exit 0
                ;;
            *)
                log_error "Unknown option: $1"
                exit 1
                ;;
        esac
    done
    
    check_prerequisites
    
    # Log startup
    log_info "LuxenOS Updater started ($(date))"
    
    if [ "$AUTO_MODE" = "1" ]; then
        # Automatic mode: perform the updates enabled in updater.conf
        if [ "$UPDATES_ON_AC_ONLY" = yes ] && on_battery; then
            log_warn "Running on battery and UPDATES_ON_AC_ONLY=yes; skipping automatic update"
            exit 0
        fi
        if [ "$CREATE_BACKUP_BEFORE_UPDATE" = yes ]; then
            create_backup
        fi
        update_package_cache
        if [ "$UPDATE_PACKAGES" = yes ]; then
            perform_upgrade
        elif [ "$AUTO_INSTALL_SECURITY" = yes ]; then
            install_security_updates
        fi
        if [ "$UPDATE_WAYDROID" = yes ]; then update_waydroid; fi
        if [ "$UPDATE_FLATPAKS" = yes ]; then update_flatpaks; fi
        if [ "$UPDATE_FIRMWARE" = yes ]; then update_firmware; fi
        check_system_health
        cleanup_system
        generate_report
        log_info "✓ Automatic update completed"
    elif [ "$CHECK_ONLY" = "1" ]; then
        # Check mode: only check, don't install
        update_package_cache
        check_available_updates
        list_available_updates
    else
        # Interactive mode
        while true; do
            show_menu
            read -r -p "Select option (0-11): " choice
            
            case $choice in
                1) update_package_cache && check_available_updates ;;
                2) create_backup && update_package_cache && perform_upgrade && generate_report ;;
                3) create_backup && update_package_cache && install_security_updates ;;
                4) list_available_updates ;;
                5) update_waydroid ;;
                6) update_flatpaks ;;
                7) create_backup && update_package_cache && perform_upgrade && update_waydroid && update_flatpaks && update_firmware && check_system_health && cleanup_system && generate_report ;;
                8) echo "=== Update History ===" && tail -n 50 "$LUXENOS_UPDATE_LOG" ;;
                9) create_backup ;;
                10) rollback_system ;;
                11) generate_report ;;
                0) log_info "Exiting updater" && exit 0 ;;
                *) log_error "Invalid option" ;;
            esac
        done
    fi
}

# Run main function
main "$@"
