#!/bin/bash
#
# LuxenOS Update Settings Manager
# Enable/disable automatic updates and configure update behavior
#
# Usage:
#   luxenos-update-settings enable       # Enable automatic updates
#   luxenos-update-settings disable      # Disable automatic updates
#   luxenos-update-settings status       # Show current status
#   luxenos-update-settings configure    # Interactive configuration
#

set -e

CONFIG_FILE="/etc/luxenos/updater.conf"
TIMER_NAME="luxenos-auto-update.timer"

# Colors
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log_info() {
    echo -e "${GREEN}✓${NC} $*"
}

log_error() {
    echo -e "${RED}✗${NC} $*"
}

log_warn() {
    echo -e "${YELLOW}!${NC} $*"
}

log_section() {
    echo -e "\n${BLUE}=== $* ===${NC}\n"
}

# Check if running as root
check_root() {
    if [ "$EUID" -ne 0 ]; then
        log_error "This command requires root privileges. Use: sudo $0"
        exit 1
    fi
}

# Enable automatic updates
enable_auto_updates() {
    check_root
    
    log_section "Enabling Automatic Updates"
    
    if [ ! -f "$CONFIG_FILE" ]; then
        log_error "Configuration file not found: $CONFIG_FILE"
        exit 1
    fi
    
    # Update config
    sed -i 's/^ENABLE_AUTO_UPDATES=.*/ENABLE_AUTO_UPDATES=yes/' "$CONFIG_FILE"
    
    # Enable systemd timer
    if systemctl enable "$TIMER_NAME" 2>/dev/null; then
        log_info "Systemd timer enabled"
    else
        log_warn "Could not enable systemd timer (may not be installed)"
    fi
    
    if systemctl start "$TIMER_NAME" 2>/dev/null; then
        log_info "Systemd timer started"
    else
        log_warn "Could not start systemd timer"
    fi
    
    log_info "Automatic updates enabled"
    log_info "Next update scheduled at: $(grep '^AUTO_UPDATE_TIME' "$CONFIG_FILE" | cut -d= -f2)"
}

# Disable automatic updates
disable_auto_updates() {
    check_root
    
    log_section "Disabling Automatic Updates"
    
    if [ ! -f "$CONFIG_FILE" ]; then
        log_error "Configuration file not found: $CONFIG_FILE"
        exit 1
    fi
    
    # Update config
    sed -i 's/^ENABLE_AUTO_UPDATES=.*/ENABLE_AUTO_UPDATES=no/' "$CONFIG_FILE"
    
    # Disable systemd timer
    if systemctl stop "$TIMER_NAME" 2>/dev/null; then
        log_info "Systemd timer stopped"
    fi
    
    if systemctl disable "$TIMER_NAME" 2>/dev/null; then
        log_info "Systemd timer disabled"
    else
        log_warn "Could not disable systemd timer"
    fi
    
    log_info "Automatic updates disabled"
    log_info "You can still run manual updates with: luxenos-updater"
}

# Show current status
show_status() {
    log_section "Automatic Update Status"
    
    if [ ! -f "$CONFIG_FILE" ]; then
        log_error "Configuration file not found: $CONFIG_FILE"
        exit 1
    fi
    
    echo "Configuration:"
    echo "  Auto Updates Enabled: $(grep '^ENABLE_AUTO_UPDATES' "$CONFIG_FILE" | cut -d= -f2)"
    echo "  Update Time: $(grep '^AUTO_UPDATE_TIME' "$CONFIG_FILE" | cut -d= -f2)"
    echo "  AC Power Only: $(grep '^UPDATES_ON_AC_ONLY' "$CONFIG_FILE" | cut -d= -f2)"
    echo "  Auto Security Updates: $(grep '^AUTO_INSTALL_SECURITY' "$CONFIG_FILE" | cut -d= -f2)"
    echo ""
    
    echo "Components to Update:"
    echo "  System Packages: $(grep '^UPDATE_PACKAGES' "$CONFIG_FILE" | cut -d= -f2)"
    echo "  Waydroid: $(grep '^UPDATE_WAYDROID' "$CONFIG_FILE" | cut -d= -f2)"
    echo "  Flatpaks: $(grep '^UPDATE_FLATPAKS' "$CONFIG_FILE" | cut -d= -f2)"
    echo "  Firmware: $(grep '^UPDATE_FIRMWARE' "$CONFIG_FILE" | cut -d= -f2)"
    echo ""
    
    # Show systemd timer status
    if command -v systemctl >/dev/null 2>&1; then
        echo "Systemd Timer Status:"
        systemctl is-enabled "$TIMER_NAME" >/dev/null 2>&1 && echo "  Timer Enabled: yes" || echo "  Timer Enabled: no"
        systemctl is-active "$TIMER_NAME" >/dev/null 2>&1 && echo "  Timer Active: yes" || echo "  Timer Active: no"
        echo ""
        
        # Show next run time
        if command -v systemctl >/dev/null 2>&1; then
            echo "Next Scheduled Run:"
            systemctl list-timers "$TIMER_NAME" 2>/dev/null | tail -n 2 || echo "  (Timer not configured)"
        fi
    fi
    
    # Show last update
    echo ""
    echo "Update History:"
    if [ -f /var/log/luxenos-updates.log ]; then
        echo "  Last Update: $(tail -n 1 /var/log/luxenos-updates.log | head -c 80)"
        echo "  Updates in log: $(grep -c '\[INFO\]' /var/log/luxenos-updates.log || echo '0')"
    else
        echo "  No update history found"
    fi
}

# Interactive configuration
configure_updates() {
    check_root
    
    log_section "Configure Automatic Updates"
    
    if [ ! -f "$CONFIG_FILE" ]; then
        log_error "Configuration file not found: $CONFIG_FILE"
        exit 1
    fi
    
    echo "Automatic Update Configuration"
    echo ""
    
    # Enable/disable
    read -p "Enable automatic updates? (yes/no) [$(grep '^ENABLE_AUTO_UPDATES' "$CONFIG_FILE" | cut -d= -f2)]: " enable_updates
    if [ -n "$enable_updates" ]; then
        sed -i "s/^ENABLE_AUTO_UPDATES=.*/ENABLE_AUTO_UPDATES=$enable_updates/" "$CONFIG_FILE"
    fi
    
    # Update time
    read -p "Time to run updates (HH:MM) [$(grep '^AUTO_UPDATE_TIME' "$CONFIG_FILE" | cut -d= -f2)]: " update_time
    if [ -n "$update_time" ]; then
        sed -i "s/^AUTO_UPDATE_TIME=.*/AUTO_UPDATE_TIME=$update_time/" "$CONFIG_FILE"
    fi
    
    # AC power only
    read -p "Only update on AC power? (yes/no) [$(grep '^UPDATES_ON_AC_ONLY' "$CONFIG_FILE" | cut -d= -f2)]: " ac_only
    if [ -n "$ac_only" ]; then
        sed -i "s/^UPDATES_ON_AC_ONLY=.*/UPDATES_ON_AC_ONLY=$ac_only/" "$CONFIG_FILE"
    fi
    
    # Auto security updates
    read -p "Auto-install security updates? (yes/no) [$(grep '^AUTO_INSTALL_SECURITY' "$CONFIG_FILE" | cut -d= -f2)]: " auto_security
    if [ -n "$auto_security" ]; then
        sed -i "s/^AUTO_INSTALL_SECURITY=.*/AUTO_INSTALL_SECURITY=$auto_security/" "$CONFIG_FILE"
    fi
    
    # Update components
    echo ""
    echo "Components to update:"
    read -p "Update system packages? (yes/no) [$(grep '^UPDATE_PACKAGES' "$CONFIG_FILE" | cut -d= -f2)]: " update_packages
    if [ -n "$update_packages" ]; then
        sed -i "s/^UPDATE_PACKAGES=.*/UPDATE_PACKAGES=$update_packages/" "$CONFIG_FILE"
    fi
    
    read -p "Update Waydroid? (yes/no) [$(grep '^UPDATE_WAYDROID' "$CONFIG_FILE" | cut -d= -f2)]: " update_waydroid
    if [ -n "$update_waydroid" ]; then
        sed -i "s/^UPDATE_WAYDROID=.*/UPDATE_WAYDROID=$update_waydroid/" "$CONFIG_FILE"
    fi
    
    read -p "Update Flatpaks? (yes/no) [$(grep '^UPDATE_FLATPAKS' "$CONFIG_FILE" | cut -d= -f2)]: " update_flatpaks
    if [ -n "$update_flatpaks" ]; then
        sed -i "s/^UPDATE_FLATPAKS=.*/UPDATE_FLATPAKS=$update_flatpaks/" "$CONFIG_FILE"
    fi
    
    # Apply settings
    if [ "${enable_updates,,}" = "yes" ]; then
        enable_auto_updates
    else
        disable_auto_updates
    fi
    
    log_info "Configuration saved to: $CONFIG_FILE"
}

# Show help
show_help() {
    cat << EOF
LuxenOS Update Settings Manager

Usage:
  luxenos-update-settings COMMAND

Commands:
  enable                    Enable automatic updates
  disable                   Disable automatic updates
  status                    Show current update settings
  configure                 Interactive configuration
  help                      Show this help message

Examples:
  sudo luxenos-update-settings enable
  sudo luxenos-update-settings status
  sudo luxenos-update-settings configure

Configuration file: $CONFIG_FILE

EOF
}

# Main
case "${1,,}" in
    enable)
        enable_auto_updates
        ;;
    disable)
        disable_auto_updates
        ;;
    status)
        show_status
        ;;
    configure)
        configure_updates
        ;;
    help)
        show_help
        ;;
    "")
        show_help
        exit 1
        ;;
    *)
        log_error "Unknown command: $1"
        show_help
        exit 1
        ;;
esac
