[Desktop Entry]
Type=Application
Name=Windows Program (Wine)
Comment=Run a Windows .exe or .msi installer with Wine
Exec=luxenos-wine-open %f
Icon=application-x-executable
Terminal=false
StartupNotify=false
Categories=Utility;
Keywords=windows;exe;msi;wine;
