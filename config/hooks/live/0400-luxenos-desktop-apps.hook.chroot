#!/bin/sh
# Verify the LuxenOS desktop apps inside the image and prepare them:
# executable modes, byte-compiled Python, and a check that every runtime
# they need is installed, so a missing package fails the build here instead
# of showing up as an app that silently never opens.

set -eu

log() { echo "[LuxenOS Apps] $*" >&2; }
die() { log "ERROR: $*"; exit 1; }

LIB=/usr/lib/luxenos/python
APPS="luxenos-launcher luxenos-dock luxenos-quick-settings luxenos-overview luxenos-monitor
      luxenos-software luxenos-restore-center luxenos-welcome luxenos-theme
      luxenos-update-manager luxenos-hardware luxenos-widgets luxenos-notifications luxenos-notify-sound
      luxenos-personalize luxenos-wallpaper luxenos-android luxenos-phone luxenos-wine-manager
      luxenos-plugins luxenos-assistant"

for f in $APPS luxenos-settings luxenos-restore luxenos-secureboot; do
    [ -f "/usr/local/bin/$f" ] || die "missing /usr/local/bin/$f"
    chmod 0755 "/usr/local/bin/$f"
done
for h in luxenos-restore-root luxenos-snapshot-root luxenos-android-root luxenos-firewall-root luxenos-pkg-root; do
    [ -f "/usr/libexec/luxenos/$h" ] || die "missing /usr/libexec/luxenos/$h"
    chmod 0755 "/usr/libexec/luxenos/$h"
done
[ -d "$LIB/luxenos" ] || die "missing $LIB/luxenos"
find "$LIB" -type d -exec chmod 0755 {} +
find "$LIB" -type f -exec chmod 0644 {} +

# Shipped plugins: data 0644, their executable 0755 (plugins.py refuses
# anything else).
for d in /usr/share/luxenos/plugins/*/; do
    [ -f "$d/plugin.conf" ] || continue
    find "$d" -type f -exec chmod 0644 {} +
    exe=$(sed -n 's/^PLUGIN_EXEC=//p' "$d/plugin.conf" | head -n 1)
    [ -n "$exe" ] && [ -f "$d/$exe" ] || die "plugin $d has no executable"
    chmod 0755 "$d/$exe"
done

# Daily "updates available" notification for every user (a user timer; it
# does nothing unless notifications are on in updater.conf).
mkdir -p /etc/systemd/user/timers.target.wants
ln -sf /etc/systemd/user/luxenos-update-notify.timer \
    /etc/systemd/user/timers.target.wants/luxenos-update-notify.timer

log "Checking Python runtime (PyGObject, GTK 4, gtk4-layer-shell, python3-apt)"
python3 - <<'PY' || die "a Python runtime the desktop apps need is missing"
import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Gtk4LayerShell", "1.0")
import ctypes
ctypes.CDLL("libgtk4-layer-shell.so.0")
import cairo  # noqa: F401  (python3-gi-cairo pulls it in; graphs need it)
from gi.repository import Gtk4LayerShell  # noqa: F401
import apt_pkg  # noqa: F401
PY

log "Byte-compiling and importing the LuxenOS modules"
python3 -m compileall -q "$LIB/luxenos" || die "LuxenOS Python modules do not compile"
for m in config swayipc apps filesearch sysinfo quick pkg restore themes welcome \
         search plugins updates snapshots hardware wallpaper widgets notifications themeinstall \
         personalize android phone flatpak appdata winemanager assistant updatemanager \
         hardwaremanager androidcenter pluginmanager; do
    PYTHONPATH=$LIB python3 -c "import luxenos.$m" || die "luxenos.$m does not import"
done

log "Checking theme packs"
for t in /usr/share/luxenos/themes/*.theme; do
    PYTHONPATH=$LIB python3 -c 'import sys; from luxenos import themes; v, e = themes.load(sys.argv[1]); sys.exit(1 if e else 0)' "$t" \
        || die "invalid theme pack $t"
done

log "Checking the plugins shipped with the image"
PYTHONPATH=$LIB python3 -c 'import sys; from luxenos import plugins; bad = {k: p.problems for k, p in plugins.discover().items() if p.problems}; print(bad) if bad else None; sys.exit(1 if bad else 0)' \
    || die "a shipped plugin is invalid"
# AppStream data is optional at run time (the Software Center falls back to
# package names), but the bindings should be there.
python3 -c 'import gi; gi.require_version("AppStream", "1.0")' 2>/dev/null \
    || log "WARNING: gir1.2-appstream-1.0 missing; the Software Center shows package names only"
command -v bwrap >/dev/null 2>&1 || log "WARNING: bubblewrap missing; launcher plugins cannot run"

if command -v desktop-file-validate >/dev/null 2>&1; then
    for d in luxenos-software luxenos-monitor luxenos-restore-center luxenos-welcome luxenos-settings luxenos-files \
             luxenos-updater luxenos-hardware luxenos-notifications luxenos-personalize luxenos-widgets \
             luxenos-android luxenos-phone luxenos-wine-manager luxenos-plugins luxenos-assistant; do
        desktop-file-validate "/usr/share/applications/$d.desktop" || die "invalid $d.desktop"
    done
fi
python3 -c 'import xml.dom.minidom as m; m.parse("/usr/share/polkit-1/actions/org.luxenos.pkg.policy")' \
    || die "polkit policy is not well-formed XML"

for prog in thunar xarchiver wlsunset lspci lsusb mokutil pw-play; do
    command -v "$prog" >/dev/null 2>&1 || log "WARNING: $prog missing; its feature reports itself unavailable"
done
log "LuxenOS desktop apps verified"
