#!/bin/sh
# LuxenOS live session: boot the USB straight into the Calamares installer.
#
# Two pieces work together:
#   * this hook: tty1 autologin for the live user (a systemd drop-in that only
#     needs the user NAME - the account itself is created by live-config at
#     boot, so it does not have to exist while the image is being built);
#   * /etc/profile.d/luxenos-session.sh: after login on tty1 it starts Sway with
#     /etc/luxenos-installer/kiosk-sway-config when the kernel command line
#     contains boot=live (and not luxenos.session=desktop). An installed
#     system has no boot=live, so it starts the normal desktop instead.
#   * luxenos-live-access.service (enabled here): at live boot, before the
#     autologin, it lets the live user run /usr/local/bin/luxenos-installer as
#     root through sudo and pkexec, so Calamares always gets root without
#     depending on live-config's sudo component. See
#     /usr/libexec/luxenos/luxenos-live-access.
#
# Both live-only pieces are also removed from the installed system by the
# Calamares shellprocess job (etc/calamares/modules/shellprocess-luxenos-cleanup.conf).

set -eu

log() {
    echo "[LuxenOS Installer Kiosk] $*" >&2
}

# Must match the username auto/config passes to live-config. Both read it from
# removeuser.conf (live-build runs hooks under "env -i", so no build-host
# variable could reach this hook anyway).
REMOVEUSER_CONF=/etc/calamares/modules/removeuser.conf
LIVE_USERNAME=$(sed -n '/^username:/{s/^username:[[:space:]]*//;s/[[:space:]]*#.*//;s/[[:space:]]*$//;p;}' "$REMOVEUSER_CONF" 2>/dev/null | head -n1)

case $LIVE_USERNAME in
    *[!a-z0-9_-]*|'')
        log "ERROR: invalid live username '$LIVE_USERNAME'"
        exit 1
        ;;
esac

for f in /etc/luxenos-installer/kiosk-sway-config /etc/profile.d/luxenos-session.sh \
    /usr/local/bin/luxenos-installer /usr/libexec/luxenos/luxenos-live-access \
    /etc/systemd/system/luxenos-live-access.service; do
    if [ ! -r "$f" ]; then
        log "ERROR: $f is missing (expected from config/includes.chroot)"
        exit 1
    fi
done

log "Configuring tty1 autologin for live user '$LIVE_USERNAME'"
mkdir -p /etc/systemd/system/getty@tty1.service.d
cat > /etc/systemd/system/getty@tty1.service.d/luxenos-autologin.conf << UNIT
[Service]
ExecStart=
ExecStart=-/sbin/agetty --autologin ${LIVE_USERNAME} --noclear %I \$TERM
UNIT

# Build-time live user name for luxenos-live-access (a username= boot
# parameter overrides it).
printf '%s\n' "$LIVE_USERNAME" > /etc/luxenos-installer/live-username

log "Enabling luxenos-live-access.service (installer root access, live boot only)"
mkdir -p /etc/systemd/system/multi-user.target.wants
ln -sf /etc/systemd/system/luxenos-live-access.service \
    /etc/systemd/system/multi-user.target.wants/luxenos-live-access.service

log "Live boot will go straight to the Calamares installer kiosk"
