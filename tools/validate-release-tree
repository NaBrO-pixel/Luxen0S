#!/bin/sh
# Validate that the LuxenOS live-build tree is merge-clean and build-layout ready.

set -eu

fail() {
    echo "ERROR: $*" >&2
    exit 1
}

check_file() {
    [ -f "$1" ] || fail "missing required file: $1"
}

check_executable() {
    check_file "$1"
    [ -x "$1" ] || fail "required script is not executable: $1"
}

check_shell_syntax() {
    check_file "$1"
    if ! sh -n "$1" 2>/tmp/luxenos-syntax-err.$$; then
        cat /tmp/luxenos-syntax-err.$$ >&2
        rm -f /tmp/luxenos-syntax-err.$$
        fail "shell syntax error in: $1"
    fi
    rm -f /tmp/luxenos-syntax-err.$$
}

if [ -f config ]; then
    fail "top-level 'config' is a file; live-build requires it to be a directory"
fi

[ -d config ] || fail "missing live-build config directory"
check_executable auto/config
check_shell_syntax auto/config

# Package lists
check_file config/package-lists/base.list.chroot
check_file config/package-lists/desktop.list.chroot
check_file config/package-lists/android.list.chroot
check_file config/package-lists/installer.list.chroot
check_file config/package-lists/security.list.chroot
check_file config/package-lists/wine.list.chroot
check_file config/package-lists/essentials.list.chroot
check_file config/includes.chroot/etc/calamares/modules/welcome.conf

# Hooks
check_executable config/hooks/live/0100-install-waydroid.hook.chroot
check_shell_syntax config/hooks/live/0100-install-waydroid.hook.chroot
check_executable config/hooks/live/0150-installer-kiosk.hook.chroot
check_shell_syntax config/hooks/live/0150-installer-kiosk.hook.chroot
check_executable config/hooks/live/0200-configure-premium-defaults.hook.chroot
check_shell_syntax config/hooks/live/0200-configure-premium-defaults.hook.chroot
check_executable config/hooks/live/0250-install-wine-and-integrations.hook.chroot
check_shell_syntax config/hooks/live/0250-install-wine-and-integrations.hook.chroot
check_executable config/hooks/live/0900-traditional-boot-menu.hook.binary
check_shell_syntax config/hooks/live/0900-traditional-boot-menu.hook.binary

# Desktop / skel configs (what the *installed* system boots into)
check_file config/includes.chroot/etc/skel/.config/sway/config
check_file config/includes.chroot/etc/skel/.config/waybar/config
check_file config/includes.chroot/etc/skel/.config/waybar/style.css
check_file config/includes.chroot/etc/skel/.config/wofi/style.css
check_file config/includes.chroot/etc/sysctl.d/99-luxenos.conf
check_executable config/includes.chroot/usr/local/bin/luxenos-health-check
check_shell_syntax config/includes.chroot/usr/local/bin/luxenos-health-check
check_executable config/includes.chroot/usr/local/bin/luxenos-power-profile-status
check_shell_syntax config/includes.chroot/usr/local/bin/luxenos-power-profile-status
check_executable config/includes.chroot/usr/local/bin/luxenos-power-profile-cycle
check_shell_syntax config/includes.chroot/usr/local/bin/luxenos-power-profile-cycle
check_file config/includes.chroot/usr/share/applications/luxenos-health-check.desktop

# Automatic updates system
check_executable config/includes.chroot/usr/local/bin/luxenos-updater
check_shell_syntax config/includes.chroot/usr/local/bin/luxenos-updater
check_executable config/includes.chroot/usr/local/bin/luxenos-update-settings
check_shell_syntax config/includes.chroot/usr/local/bin/luxenos-update-settings
check_file config/includes.chroot/usr/share/applications/luxenos-updater.desktop
check_file config/includes.chroot/etc/systemd/system/luxenos-auto-update.service
check_file config/includes.chroot/etc/systemd/system/luxenos-auto-update.timer
check_file config/includes.chroot/etc/luxenos/updater.conf
check_file config/includes.chroot/etc/luxenos-version
check_executable config/hooks/live/0300-setup-auto-updates.hook.chroot
check_shell_syntax config/hooks/live/0300-setup-auto-updates.hook.chroot

# Liquid-glass theme, .deb / .exe double-click integration
check_file config/includes.chroot/etc/luxenos/glass.conf
check_file config/includes.chroot/etc/luxenos/wine.conf
check_file config/includes.chroot/etc/xdg/mimeapps.list
check_file config/includes.chroot/etc/skel/.config/wofi/config
check_file config/includes.chroot/etc/skel/.config/gtk-3.0/gtk.css
check_file config/includes.chroot/etc/skel/.config/gtk-4.0/gtk.css
check_file config/includes.chroot/usr/share/polkit-1/actions/org.luxenos.pkg.policy
check_file config/includes.chroot/usr/share/applications/luxenos-deb-install.desktop
check_file config/includes.chroot/usr/share/applications/luxenos-wine-open.desktop
check_file config/includes.chroot/usr/share/applications/luxenos-accessibility-settings.desktop
check_file config/includes.chroot/usr/local/bin/luxenos-accessibility-settings
check_shell_syntax config/includes.chroot/usr/local/bin/luxenos-accessibility-settings
for script in \
    config/includes.chroot/usr/local/bin/luxenos-glass \
    config/includes.chroot/usr/local/bin/luxenos-waybar \
    config/includes.chroot/usr/local/bin/luxenos-controls \
    config/includes.chroot/usr/local/bin/luxenos-polkit-agent \
    config/includes.chroot/usr/local/bin/luxenos-deb-install \
    config/includes.chroot/usr/local/bin/luxenos-wine-open \
    config/includes.chroot/usr/local/bin/luxenos-session-init \
    config/includes.chroot/usr/local/bin/luxenos-network \
    config/includes.chroot/usr/local/bin/luxenos-lock \
    config/includes.chroot/usr/local/bin/luxenos-setup-android \
    config/includes.chroot/usr/local/bin/luxenos-installer \
    config/includes.chroot/usr/libexec/luxenos/luxenos-live-access \
    config/includes.chroot/usr/libexec/luxenos/luxenos-pkg-root
do
    check_executable "$script"
    check_shell_syntax "$script"
done

check_file config/includes.chroot/etc/profile.d/luxenos-session.sh
check_shell_syntax config/includes.chroot/etc/profile.d/luxenos-session.sh
check_file config/includes.chroot/usr/share/applications/luxenos-android-setup.desktop
check_file config/includes.chroot/etc/calamares/modules/shellprocess-luxenos-cleanup.conf
check_file config/includes.chroot/etc/calamares/modules/removeuser.conf

# Every module named in the Calamares sequence must have a config or be a
# stock Calamares module (guards against re-introducing a nonexistent one).
if grep -qE '^ *- (removefiles|displaymanager)$' config/includes.chroot/etc/calamares/settings.conf; then
    fail "calamares settings.conf lists removefiles/displaymanager (not available in LuxenOS)"
fi

# Branding: no stale internal "lapdroid" references (old project name).
if grep -rIl --exclude-dir=.git --exclude='*.tar.gz' --exclude=validate-release-tree -i 'lapdroid' . 2>/dev/null | grep -q .; then
    fail "stale 'lapdroid' references remain: $(grep -rIl --exclude-dir=.git --exclude='*.tar.gz' --exclude=validate-release-tree -i 'lapdroid' . | tr '\n' ' ')"
fi

# Glass config keys documented in glass.conf must all be understood by the generator.
# shellcheck disable=SC2013
for key in $(sed -n 's/^#\{0,1\}\(GLASS_[A-Z_]*\)=.*/\1/p' config/includes.chroot/etc/luxenos/glass.conf); do
    grep -q "$key" config/includes.chroot/usr/local/bin/luxenos-glass \
        || fail "glass.conf documents $key but luxenos-glass does not use it"
done

# The polkit action must point at the exact helper path that ships in the image.
grep -q '/usr/libexec/luxenos/luxenos-pkg-root</annotate>' \
    config/includes.chroot/usr/share/polkit-1/actions/org.luxenos.pkg.policy \
    || fail "polkit policy does not reference /usr/libexec/luxenos/luxenos-pkg-root"

# Both handlers must be the MIME defaults for what they claim to handle.
for mime in application/vnd.debian.binary-package \
            application/vnd.microsoft.portable-executable application/x-msi; do
    grep -q "^$mime=luxenos-" config/includes.chroot/etc/xdg/mimeapps.list \
        || fail "mimeapps.list has no LuxenOS default for $mime"
done

# Wine must be requested (32-bit half is installed by hook 0250).
grep -qx 'wine64' config/package-lists/wine.list.chroot || fail "wine64 missing from wine.list.chroot"

# The glass generator must run under plain POSIX sh for a brand-new user.
glass_home=$(mktemp -d)
if ! HOME="$glass_home" XDG_CONFIG_HOME="$glass_home/.config" \
    LUXENOS_GLASS_SYS_CONF=config/includes.chroot/etc/luxenos/glass.conf \
    sh config/includes.chroot/usr/local/bin/luxenos-glass apply --files-only >/dev/null 2>&1; then
    rm -rf "$glass_home"
    fail "luxenos-glass apply failed"
fi
[ -s "$glass_home/.config/luxenos/glass/waybar.css" ] || { rm -rf "$glass_home"; fail "luxenos-glass produced no waybar.css"; }
for preset in performance balanced rich; do
    mkdir -p "$glass_home/.config/luxenos"
    printf 'GLASS_PRESET=%s\nGLASS_REDUCE_MOTION=yes\nGLASS_OPACITY=abc\n' "$preset" > "$glass_home/.config/luxenos/glass.conf"
    HOME="$glass_home" XDG_CONFIG_HOME="$glass_home/.config" \
        LUXENOS_GLASS_SYS_CONF=config/includes.chroot/etc/luxenos/glass.conf \
        sh config/includes.chroot/usr/local/bin/luxenos-glass apply --files-only >/dev/null 2>&1 \
        || { rm -rf "$glass_home"; fail "luxenos-glass apply failed for preset $preset (invalid value must not break it)"; }
    grep -q 'transition: none' "$glass_home/.config/luxenos/glass/waybar.css" \
        || { rm -rf "$glass_home"; fail "GLASS_REDUCE_MOTION=yes did not disable transitions ($preset)"; }
done
# Exercise the Accessibility slider end-to-end at its boundary and midpoint.
for intensity in 0 50 100; do
    HOME="$glass_home" XDG_CONFIG_HOME="$glass_home/.config" \
        LUXENOS_GLASS_SYS_CONF=config/includes.chroot/etc/luxenos/glass.conf \
        sh config/includes.chroot/usr/local/bin/luxenos-glass intensity "$intensity" >/dev/null 2>&1 \
        || { rm -rf "$glass_home"; fail "Liquid Glass intensity $intensity could not be applied"; }
    actual=$(HOME="$glass_home" XDG_CONFIG_HOME="$glass_home/.config" \
        LUXENOS_GLASS_SYS_CONF=config/includes.chroot/etc/luxenos/glass.conf \
        sh config/includes.chroot/usr/local/bin/luxenos-glass get intensity)
    [ "$actual" = "$intensity" ] || { rm -rf "$glass_home"; fail "intensity getter returned '$actual' for $intensity"; }
done

# A configured system-wide intensity must drive the generated theme when no
# per-user override exists.
system_glass_conf="$glass_home/system-glass.conf"
sed 's/^#GLASS_INTENSITY=55$/GLASS_INTENSITY=100/' config/includes.chroot/etc/luxenos/glass.conf > "$system_glass_conf"
rm -f "$glass_home/.config/luxenos/glass.conf"
HOME="$glass_home" XDG_CONFIG_HOME="$glass_home/.config" LUXENOS_GLASS_SYS_CONF="$system_glass_conf" \
    sh config/includes.chroot/usr/local/bin/luxenos-glass apply --files-only >/dev/null 2>&1 \
    || { rm -rf "$glass_home"; fail "system-wide GLASS_INTENSITY default failed"; }
actual=$(HOME="$glass_home" XDG_CONFIG_HOME="$glass_home/.config" LUXENOS_GLASS_SYS_CONF="$system_glass_conf" \
    sh config/includes.chroot/usr/local/bin/luxenos-glass get intensity)
[ "$actual" = 100 ] || { rm -rf "$glass_home"; fail "system intensity getter returned '$actual' instead of 100"; }
grep -q 'border-radius: 16px' "$glass_home/.config/luxenos/glass/waybar.css" \
    || { rm -rf "$glass_home"; fail "system intensity did not affect generated corner radius"; }

# Preset selection should replace slider-owned values with its exact preset.
HOME="$glass_home" XDG_CONFIG_HOME="$glass_home/.config" LUXENOS_GLASS_SYS_CONF=config/includes.chroot/etc/luxenos/glass.conf \
    sh config/includes.chroot/usr/local/bin/luxenos-glass intensity 75 >/dev/null 2>&1 \
    || { rm -rf "$glass_home"; fail "Liquid Glass intensity 75 could not be applied"; }
HOME="$glass_home" XDG_CONFIG_HOME="$glass_home/.config" LUXENOS_GLASS_SYS_CONF=config/includes.chroot/etc/luxenos/glass.conf \
    sh config/includes.chroot/usr/local/bin/luxenos-glass preset balanced >/dev/null 2>&1 \
    || { rm -rf "$glass_home"; fail "balanced preset could not be applied after slider"; }
grep -qx 'GLASS_INTENSITY=55' "$glass_home/.config/luxenos/glass.conf" \
    || { rm -rf "$glass_home"; fail "balanced preset did not reset slider value"; }
grep -qx 'GLASS_RADIUS=12' "$glass_home/.config/luxenos/glass.conf" \
    || { rm -rf "$glass_home"; fail "balanced preset did not restore its radius"; }
rm -rf "$glass_home"

if command -v desktop-file-validate >/dev/null 2>&1; then
    desktop-file-validate config/includes.chroot/usr/share/applications/luxenos-deb-install.desktop \
        || fail "invalid luxenos-deb-install.desktop"
    desktop-file-validate config/includes.chroot/usr/share/applications/luxenos-wine-open.desktop \
        || fail "invalid luxenos-wine-open.desktop"
    desktop-file-validate config/includes.chroot/usr/share/applications/luxenos-accessibility-settings.desktop \
        || fail "invalid luxenos-accessibility-settings.desktop"
fi

# Kiosk / installer boot experience (what the live disc itself boots into)
check_file config/includes.chroot/etc/luxenos-installer/kiosk-sway-config
check_file config/includes.chroot/etc/calamares/branding/luxenos/branding.desc
check_file config/includes.chroot/etc/calamares/settings.conf
# Calamares must be started as root (via luxenos-installer), and the installed
# system needs GRUB inside the image for Calamares' bootloader job.
if grep -qE '^ *(exec|bindsym .* exec) +calamares *$' \
    config/includes.chroot/etc/luxenos-installer/kiosk-sway-config \
    config/includes.chroot/etc/skel/.config/sway/config; then
    fail "Sway config starts calamares directly (unprivileged); use luxenos-installer"
fi
# Live-only root access for the installer: the service must stay conditional
# on a live boot, be enabled by the kiosk hook, and be removed from the
# installed system by luxenos-finish-install (run by the Calamares cleanup job
# and by the traditional image's Debian installer).
live_unit=config/includes.chroot/etc/systemd/system/luxenos-live-access.service
check_file "$live_unit"
grep -qx 'ConditionKernelCommandLine=boot=live' "$live_unit" \
    || fail "$live_unit must only run on a live boot (ConditionKernelCommandLine=boot=live)"
grep -q 'multi-user.target.wants/luxenos-live-access.service' \
    config/hooks/live/0150-installer-kiosk.hook.chroot \
    || fail "0150-installer-kiosk hook does not enable luxenos-live-access.service"
for path in /etc/systemd/system/luxenos-live-access.service \
    /etc/systemd/system/multi-user.target.wants/luxenos-live-access.service \
    /usr/libexec/luxenos/luxenos-live-access \
    /etc/sudoers.d/luxenos-live-installer \
    /etc/polkit-1/rules.d/49-luxenos-live-installer.rules; do
    grep -q -- "$path" config/includes.chroot/usr/libexec/luxenos/luxenos-finish-install \
        || fail "luxenos-finish-install does not remove $path from the installed system"
done
# Nothing that grants root may be shipped statically in the image.
if [ -e config/includes.chroot/etc/sudoers.d ] || [ -e config/includes.chroot/etc/polkit-1/rules.d ]; then
    fail "config/includes.chroot must not ship sudoers.d / polkit rules (they would be copied to installed systems)"
fi
for pkg in grub-pc grub-efi-amd64-bin; do
    grep -qx "$pkg" config/package-lists/installer.list.chroot \
        || fail "$pkg missing from installer.list.chroot (Calamares bootloader job needs it)"
done

# Post-install conversion shared by Calamares and the Debian installer
check_executable config/includes.chroot/usr/libexec/luxenos/luxenos-finish-install
check_shell_syntax config/includes.chroot/usr/libexec/luxenos/luxenos-finish-install
grep -q '/usr/libexec/luxenos/luxenos-finish-install' \
    config/includes.chroot/etc/calamares/modules/shellprocess-luxenos-cleanup.conf \
    || fail "Calamares cleanup job does not run luxenos-finish-install"

# Traditional (Debian installer) image
check_file config/includes.installer/preseed.cfg
grep -q '^d-i preseed/late_command string in-target /usr/libexec/luxenos/luxenos-finish-install$' \
    config/includes.installer/preseed.cfg \
    || fail "preseed.cfg does not run luxenos-finish-install as its late_command"
grep -q '^d-i pkgsel/run_tasksel boolean false$' config/includes.installer/preseed.cfg \
    || fail "preseed.cfg must skip tasksel (it would add Debian's GNOME desktop)"

# Branding
check_file config/includes.chroot/usr/share/backgrounds/luxenos/wallpaper.png
check_file config/includes.chroot/usr/share/plymouth/themes/luxenos/luxenos.plymouth
check_file config/includes.chroot/usr/share/plymouth/themes/luxenos/luxenos.script
check_file config/includes.chroot/boot/grub/themes/luxenos/theme.txt

# Image variants: all three must configure, only the live variant may preset
# the desktop session, and only the traditional variant may carry the Debian
# installer. Uses a stub `lb` so this runs without live-build installed.
variant_dir=$(mktemp -d)
cat > "$variant_dir/lb" <<'STUB'
#!/bin/sh
for a in "$@"; do printf '%s\n' "$a"; done
STUB
chmod +x "$variant_dir/lb"

variant_bootappend() {
    VARIANT="$1" PATH="$variant_dir:$PATH" sh auto/config 2>/dev/null \
        | grep -m1 '^boot=live '
}

installer_append=$(variant_bootappend installer) || {
    rm -rf "$variant_dir"
    fail "auto/config produced no boot parameters for VARIANT=installer"
}
live_append=$(variant_bootappend live) || {
    rm -rf "$variant_dir"
    fail "auto/config produced no boot parameters for VARIANT=live"
}

traditional_append=$(variant_bootappend traditional) || {
    rm -rf "$variant_dir"
    fail "auto/config produced no boot parameters for VARIANT=traditional"
}

for append in "$installer_append" "$traditional_append"; do
    case $append in
        *luxenos.session=desktop*)
            rm -rf "$variant_dir"
            fail "VARIANT=installer/traditional must not preset luxenos.session=desktop"
            ;;
    esac
done

# The stub prints one argument per line, so "--debian-installer" is followed by
# its value on the next line.
variant_debian_installer() {
    VARIANT="$1" PATH="$variant_dir:$PATH" sh auto/config 2>/dev/null \
        | sed -n '/^--debian-installer$/{n;p;q}'
}
for v in installer:none live:none traditional:live; do
    got=$(variant_debian_installer "${v%%:*}")
    if [ "$got" != "${v#*:}" ]; then
        rm -rf "$variant_dir"
        fail "VARIANT=${v%%:*} must configure --debian-installer ${v#*:} (got '${got}')"
    fi
done

case $live_append in
    *luxenos.session=desktop*) ;;
    *)
        rm -rf "$variant_dir"
        fail "VARIANT=live must preset luxenos.session=desktop"
        ;;
esac

# The live user must come from removeuser.conf, never from the builder's
# environment (desktop sessions export USERNAME as the builder's login name).
case $(USERNAME=not-the-live-user VARIANT=installer PATH="$variant_dir:$PATH" sh auto/config 2>/dev/null \
        | grep -m1 '^boot=live ') in
    *" username=$(sed -n '/^username:/{s/^username:[[:space:]]*//;s/[[:space:]]*#.*//;s/[[:space:]]*$//;p;}' \
        config/includes.chroot/etc/calamares/modules/removeuser.conf | head -n1) "*) ;;
    *)
        rm -rf "$variant_dir"
        fail "auto/config's live username does not match removeuser.conf"
        ;;
esac

if VARIANT=nonsense PATH="$variant_dir:$PATH" sh auto/config >/dev/null 2>&1; then
    rm -rf "$variant_dir"
    fail "auto/config accepted an invalid VARIANT"
fi
rm -rf "$variant_dir"

# The parameter the live variant sets must be the one the session script acts on.
grep -q 'luxenos.session=desktop' config/includes.chroot/etc/profile.d/luxenos-session.sh \
    || fail "luxenos-session.sh does not act on luxenos.session=desktop"

# CI
check_file .github/workflows/validate.yml

if command -v rg >/dev/null 2>&1; then
    if rg -n '^(<<<<<<<|=======|>>>>>>>)' README.md auto config tools .github CONTRIBUTING.md >/dev/null 2>&1; then
        rg -n '^(<<<<<<<|=======|>>>>>>>)' README.md auto config tools .github CONTRIBUTING.md >&2
        fail "merge conflict markers remain"
    fi
else
    if grep -rnE '^(<<<<<<<|=======|>>>>>>>)' README.md auto config tools .github CONTRIBUTING.md >/dev/null 2>&1; then
        grep -rnE '^(<<<<<<<|=======|>>>>>>>)' README.md auto config tools .github CONTRIBUTING.md >&2
        fail "merge conflict markers remain"
    fi
fi

echo "LuxenOS release tree is merge-clean and syntax-valid."
